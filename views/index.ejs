        /* ===== V6.7 PREMIUM MOTION / RESPONSIVE POLISH ===== */
        .announcement-ticker{position:relative;z-index:998;overflow:hidden;background:linear-gradient(90deg,rgba(108,99,255,.16),rgba(0,212,255,.12),rgba(255,101,132,.12));border-bottom:1px solid rgba(255,255,255,.10);box-shadow:0 8px 30px rgba(0,0,0,.18)}
        .announcement-track{display:flex;width:max-content;min-width:100%;animation:tickerMove 24s linear infinite;will-change:transform}
        .announcement-item{white-space:nowrap;padding:.72rem 3rem;font-size:.9rem;font-weight:700;letter-spacing:.2px;color:#fff}
        .announcement-ticker:hover .announcement-track{animation-play-state:paused}
        @keyframes tickerMove{from{transform:translateX(100vw)}to{transform:translateX(-100%)}}
        .analytics-pair{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1rem;align-items:start;margin-bottom:2rem}
        .analytics-mini-card{min-width:0;overflow:hidden}
        .analytics-mini-card .stat-item span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
        .btn,.feature-card,.stat-card,.glass-card,.link-card{transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease,background .25s ease}
        .btn{position:relative;overflow:hidden}.btn::after{content:'';position:absolute;inset:0;transform:translateX(-120%);background:linear-gradient(110deg,transparent 20%,rgba(255,255,255,.18) 50%,transparent 80%);transition:transform .55s ease;pointer-events:none}.btn:hover::after{transform:translateX(120%)}.btn:active{transform:scale(.97)}
        .glass-card:hover,.link-card:hover,.feature-card:hover{box-shadow:0 14px 48px rgba(0,0,0,.32)}.stat-card:hover{transform:translateY(-5px) scale(1.015)}
