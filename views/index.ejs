        async function saveEmail() {
            var emailInput = document.getElementById('editEmail');
            if (!emailInput) return;
            
            var email = emailInput.value.trim();
            
            if (!email) {
                showToast('Email is required', 'error');
                return;
            }

            var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                showToast('Please enter a valid email address', 'error');
                return;
            }

            try {
                var response = await fetch('/api/update-profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });

                var data = await response.json();
                
                if (data.success) {
                    showToast('Email updated successfully!', 'success');
                    loadProfileData();
                    var ddEmailEl = document.querySelector('.dropdown-menu .dd-email');
                    if (ddEmailEl) ddEmailEl.textContent = data.user.email || 'No email set';
                } else {
                    showToast(data.error || 'Failed to update email', 'error');
                }
            } catch (error) {
                showToast('Failed to update email', 'error');
            }
        }

        // ===== TIMEZONE =====
        async function updateTimezone() {
            var select = document.getElementById('userTimezone');
            if (!select) return;
            
            var timezone = select.value;
            if (!timezone) return;

            try {
                var response = await fetch('/api/update-timezone', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ timezone: timezone })
                });

                var data = await response.json();
                
                if (data.success) {
                    showToast('Timezone updated successfully!', 'success');
                    updateCurrentTime();
                } else {
                    showToast(data.error || 'Failed to update timezone', 'error');
                }
            } catch (error) {
                showToast('Failed to update timezone', 'error');
            }
        }

        function updateCurrentTime() {
            var select = document.getElementById('userTimezone');
            if (!select) return;
            
            var timezone = select.value || 'Asia/Dhaka';
            var display = document.getElementById('currentTimeDisplay');
            
            if (display) {
                try {
                    var now = new Date();
                    var options = {
                        timeZone: timezone,
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit',
                        hour12: true
                    };
                    display.textContent = now.toLocaleString('en-US', options);
                } catch (e) {
                    display.textContent = 'Loading time...';
                }
            }
        }

        function convertLinkDates() {
            var select = document.getElementById('userTimezone');
            if (!select) return;
            
            var timezone = select.value || 'Asia/Dhaka';
            
            document.querySelectorAll('.link-date').forEach(function(el) {
                var dateStr = el.getAttribute('data-date');
                if (dateStr) {
                    try {
                        var date = new Date(dateStr);
                        var options = {
                            timeZone: timezone,
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        };
                        el.textContent = date.toLocaleString('en-US', options);
                    } catch (e) {}
                }
            });
        }

