        // ===== EDIT FUNCTIONS =====
        function editField(field) {
            if (field === 'name') {
                var nameDisplay = document.getElementById('nameDisplay');
                var nameEdit = document.getElementById('nameEdit');
                if (nameDisplay) nameDisplay.style.display = 'none';
                if (nameEdit) nameEdit.style.display = 'block';
            } else if (field === 'displayName') {
                var displayNameDisplay = document.getElementById('displayNameDisplay');
                var displayNameEdit = document.getElementById('displayNameEdit');
                if (displayNameDisplay) displayNameDisplay.style.display = 'none';
                if (displayNameEdit) displayNameEdit.style.display = 'block';
            } else if (field === 'email') {
                var emailDisplay = document.getElementById('emailDisplay');
                var emailEdit = document.getElementById('emailEdit');
                if (emailDisplay) emailDisplay.style.display = 'none';
                if (emailEdit) emailEdit.style.display = 'block';
            }
        }

        function cancelEdit(field) {
            if (field === 'name') {
                var nameDisplay = document.getElementById('nameDisplay');
                var nameEdit = document.getElementById('nameEdit');
                if (nameDisplay) nameDisplay.style.display = 'block';
                if (nameEdit) nameEdit.style.display = 'none';
            } else if (field === 'displayName') {
                var displayNameDisplay = document.getElementById('displayNameDisplay');
                var displayNameEdit = document.getElementById('displayNameEdit');
                if (displayNameDisplay) displayNameDisplay.style.display = 'block';
                if (displayNameEdit) displayNameEdit.style.display = 'none';
            } else if (field === 'email') {
                var emailDisplay = document.getElementById('emailDisplay');
                var emailEdit = document.getElementById('emailEdit');
                if (emailDisplay) emailDisplay.style.display = 'block';
                if (emailEdit) emailEdit.style.display = 'none';
            }
        }

        // ===== SAVE FUNCTIONS =====
        async function saveName() {
            var firstNameInput = document.getElementById('editFirstName');
            var lastNameInput = document.getElementById('editLastName');
            if (!firstNameInput || !lastNameInput) return;
            
            var firstName = firstNameInput.value.trim();
            var lastName = lastNameInput.value.trim();
            
            if (!firstName) {
                showToast('First name is required', 'error');
                return;
            }

            try {
                var response = await fetch('/api/update-profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ firstName: firstName, lastName: lastName })
                });

                var data = await response.json();
                
                if (data.success) {
                    showToast('Profile updated successfully!', 'success');
                    loadProfileData();
                    var userNameEl = document.querySelector('.user-profile-btn .user-name');
                    var avatarEl = document.querySelector('.user-profile-btn .avatar');
                    var ddNameEl = document.querySelector('.dropdown-menu .dd-name');
                    if (userNameEl) userNameEl.textContent = data.user.displayName || data.user.firstName;
                    if (avatarEl) avatarEl.textContent = data.user.displayName.charAt(0).toUpperCase();
                    if (ddNameEl) ddNameEl.textContent = data.user.displayName || data.user.firstName;
                } else {
                    showToast(data.error || 'Failed to update profile', 'error');
                }
            } catch (error) {
                showToast('Failed to update profile', 'error');
            }
        }

