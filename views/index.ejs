                                    </select>
                                </div>
                                <div class="form-group">
                                    <label><i class="fas fa-lock"></i> Password <span>Premium</span></label>
                                    <input class="form-control" type="password" name="linkPassword" minlength="4" maxlength="100" placeholder="Optional password">
                                </div>
                            </div>

                            <% if(typeof domainChoices!=='undefined' && domainChoices && domainChoices.some(function(d){return !d.selectable;})){ %>
                                <div class="create-domain-status">
                                    <i class="fas fa-circle-info"></i>
                                    <div><strong>Domain notice</strong><span>Maintenance/Coming Soon domains are visible but cannot be selected yet.</span></div>
                                </div>
                            <% } %>

                            <div class="create-modal-bottom">
                                <div class="create-speed-note"><i class="fas fa-bolt"></i><span><strong>Fast 302 Redirect</strong><small>Analytics + bot detection included</small></span></div>
                                <button type="submit" class="btn btn-primary create-modal-submit"><i class="fas fa-rocket"></i> Shorten Now</button>
                            </div>
                        </form>
                    </div>
                </div>

        <% } %>


