                            <option value="6h">6 Hours</option>
                            <option value="12h">12 Hours</option>
                            <option value="24h">24 Hours</option>
                            <option value="custom">Custom Minutes</option>
                        </select>
                        <input class="form-control" type="number" name="customMinutes" id="maintenanceCustomMinutes" min="1" max="10080" placeholder="Custom minutes (1–10080)" style="display:none;margin-top:.45rem;">
                        <small class="maintenance-field-help">Timezone-safe. Server will use current time + selected duration.</small>
                    </div>

                    <div class="form-group" id="maintenanceExactGroup" style="display:none;">
                        <label>Exact Auto Resume Date & Time</label>
                        <input class="form-control" type="datetime-local" name="maintenanceUntil" id="maintenanceUntilInput">
                        <input type="hidden" name="timezoneOffset" id="maintenanceTimezoneOffset">
                        <small class="maintenance-field-help">Use this only if you need an exact clock time.</small>
                    </div>

                    <% if(maintenanceUntil){ %>
                    <div class="form-group">
                        <label>Current Scheduled Resume</label>
                        <div class="maintenance-current-schedule">
                            <span id="maintenanceCurrentAuto" data-utc="<%= maintenanceUntil %>"></span>
                            <small id="maintenanceCurrentLeft"></small>
                        </div>
                    </div>
                    <% } %>

                    <button class="btn btn-secondary" type="submit">
                        <i class="fas fa-floppy-disk"></i> Save Maintenance Settings
                    </button>
                </form>
                <div class="maintenance-toggle-row">
                    <form method="POST" action="/admin/site-maintenance/toggle" onsubmit="return confirm('<%= siteMaintenanceOn?'Turn maintenance OFF and restore the website?':'Turn maintenance ON? Public pages, API and all short links will pause.' %>')"><button class="btn <%= siteMaintenanceOn?'btn-primary':'btn-warning' %>" type="submit"><i class="fas <%= siteMaintenanceOn?'fa-play':'fa-screwdriver-wrench' %>"></i> <%= siteMaintenanceOn?'Turn Maintenance OFF — Resume Website':'Turn Maintenance ON — Pause Website' %></button></form>
                    <span class="maintenance-persist-note"><i class="fas fa-database"></i> State saved in PostgreSQL — Railway redeploy/restart will not turn it off.</span>
                </div>
                <% if(siteMaintenanceUpdated){ %><small class="maintenance-last-change">Last changed: <%= siteMaintenanceUpdated.updated_at?new Date(siteMaintenanceUpdated.updated_at).toLocaleString():'-' %> · <%= siteMaintenanceUpdated.updated_by||'admin' %></small><% } %>
            </div>

            <div class="glass-card admin-redeem-card" style="margin-bottom:1.5rem;">
                <div class="admin-redeem-head"><div><div class="dashboard-kicker">PREMIUM PROMOTION</div><h2>🎟️ Redeem Code Manager</h2><p>Generate a code, set how many Premium days it adds and the maximum number of users who can redeem it.</p></div></div>
                <form method="POST" action="/admin/redeem-codes/create" class="admin-redeem-create">
                    <div class="form-group"><label>Custom Code (optional)</label><input class="form-control" name="code" maxlength="64" placeholder="Leave empty to auto-generate"></div>
                    <div class="form-group"><label>Premium Validity (days)</label><input class="form-control" type="number" name="premiumDays" min="1" max="3650" value="30" required></div>
                    <div class="form-group"><label>Maximum Users</label><input class="form-control" type="number" name="maxUses" min="1" max="100000" value="1" required></div>
                    <div class="form-group admin-redeem-submit-wrap"><label>&nbsp;</label><button class="btn btn-primary" type="submit"><i class="fas fa-wand-magic-sparkles"></i> Generate Code</button></div>
                </form>
                <div class="admin-table-wrap" style="margin-top:1rem;"><table class="admin-table"><thead><tr><th>Code</th><th>Premium</th><th>Used</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead><tbody>
                <% (adminRedeemCodes||[]).forEach(function(r){ %><tr><td><div class="admin-code-copy-row"><code><%= r.code %></code><button type="button" class="copy-payment-btn" onclick="navigator.clipboard.writeText('<%= r.code %>');showToast('Redeem code copied','success')"><i class="fas fa-copy"></i> Copy</button></div></td><td><strong><%= r.premium_days %> days</strong></td><td><strong><%= r.used_count %> / <%= r.max_uses %></strong></td><td><span class="domain-state-pill <%= r.is_active && Number(r.used_count)<Number(r.max_uses)?'active':'coming' %>"><%= !r.is_active?'Disabled':(Number(r.used_count)>=Number(r.max_uses)?'Limit Reached':'Active') %></span></td><td><%= new Date(r.created_at).toLocaleString() %></td><td><div class="admin-actions"><form method="POST" action="/admin/redeem-codes/<%= r.id %>/toggle"><button class="btn btn-sm btn-secondary"><%= r.is_active?'Disable':'Enable' %></button></form><form method="POST" action="/admin/redeem-codes/<%= r.id %>/delete" onsubmit="return confirm('Delete this redeem code and usage history?')"><button class="btn btn-sm btn-danger">Delete</button></form></div></td></tr><% }); %>
                <% if(!(adminRedeemCodes||[]).length){ %><tr><td colspan="6">No redeem codes generated yet.</td></tr><% } %>
                </tbody></table></div>
            </div>

            <div class="glass-card admin-redeemed-users-card" style="margin-bottom:1.5rem;">
                <div class="admin-redeem-head">
                    <div><div class="dashboard-kicker">REDEEM ACTIVITY</div><h2>👥 Redeemed Users — Full Details</h2><p>Every successful redeem is listed here with the user's account, Telegram and Premium information.</p></div>
                    <span class="maintenance-status-pill off"><%= (adminRedeemUsers||[]).length %> Redeem(s)</span>
                </div>
                <div class="admin-table-wrap redeem-user-table-wrap">
                    <table class="admin-table redeem-user-table">
                        <thead><tr>
                            <th>Redeemed</th><th>Code</th><th>User</th><th>Telegram</th><th>Email</th><th>Account</th><th>Premium</th><th>Usage</th><th>Dates</th><th>Action</th>
                        </tr></thead>
                        <tbody>
                        <% (adminRedeemUsers||[]).forEach(function(r){ %>
                            <tr>
                                <td><strong><%= new Date(r.redeemed_at).toLocaleString() %></strong><br><small>+<%= r.premium_days %> days</small></td>
                                <td><code><%= r.code %></code></td>
                                <td>
                                    <strong><%= r.display_name || ((r.first_name||'')+' '+(r.last_name||'')).trim() || r.username || ('User #'+r.user_id) %></strong><br>
                                    <small>ID: <%= r.user_id %> · @<%= r.username || 'N/A' %></small><br>
                                    <small>Timezone: <%= r.timezone || 'N/A' %></small>
                                </td>
                                <td><strong><%= r.telegram_id || 'N/A' %></strong></td>
                                <td><%= r.email || 'N/A' %></td>
                                <td><span class="status-pill <%= r.account_status==='active'?'ok':'bad' %>"><%= r.account_status || 'active' %></span></td>
                                <td>
                                    <strong><%= r.plan_type || 'free' %></strong><br>
                                    <small><%= r.premium_until ? ('Until '+new Date(r.premium_until).toLocaleString()) : 'No expiry' %></small>
                                </td>
                                <td>
                                    <small>Links: <%= r.total_links || 0 %></small><br>
                                    <small>Lifetime Created: <%= r.lifetime_links_created || 0 %></small><br>
                                    <small>Clicks: <%= Number(r.total_clicks||0).toLocaleString() %></small>
                                </td>
                                <td>
                                    <small>Joined: <%= r.user_created_at ? new Date(r.user_created_at).toLocaleString() : '-' %></small><br>
                                    <small>Last Login: <%= r.last_login ? new Date(r.last_login).toLocaleString() : '-' %></small>
                                </td>
                                <td><a class="btn btn-sm btn-secondary" href="/admin/users/<%= r.user_id %>/stats"><i class="fas fa-chart-line"></i> Full Stats</a></td>
                            </tr>
                        <% }); %>
                        <% if(!(adminRedeemUsers||[]).length){ %><tr><td colspan="10">No user has redeemed a code yet.</td></tr><% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="glass-card" style="margin-bottom:1.5rem;">
                <h2>📢 Site Announcement / News Ticker</h2>
                <p style="color:var(--text-muted);margin:.4rem 0 1rem;">Publish one active scrolling announcement across public, login and user pages. It remains visible until you turn it off.</p>
                <form method="POST" action="/admin/announcement" style="display:flex;gap:.6rem;flex-wrap:wrap;">
                    <input class="form-control" name="message" maxlength="500" required placeholder="Example: New custom domain launching tonight" style="flex:1;min-width:260px;">
                    <button class="btn btn-primary">Publish Announcement</button>
                </form>
                <div class="admin-table-wrap" style="margin-top:1rem;"><table class="admin-table"><thead><tr><th>Message</th><th>Status</th><th>Updated</th><th>Actions</th></tr></thead><tbody>
                <% (adminAnnouncements||[]).forEach(function(a){ %><tr><td style="max-width:420px;white-space:normal;"><%= a.message %></td><td><%= a.is_active?'Active':'Off' %></td><td><%= new Date(a.updated_at).toLocaleString() %></td><td><div class="admin-actions"><form method="POST" action="/admin/announcement/<%= a.id %>/toggle"><button class="btn btn-sm <%= a.is_active?'btn-warning':'btn-secondary' %>"><%= a.is_active?'Turn Off':'Activate' %></button></form><form method="POST" action="/admin/announcement/<%= a.id %>/delete" onsubmit="return confirm('Delete this announcement?')"><button class="btn btn-sm btn-danger">Delete</button></form></div></td></tr><% }); %>
                <% if(!(adminAnnouncements||[]).length){ %><tr><td colspan="4">No announcements yet.</td></tr><% } %>
                </tbody></table></div>
            </div>

            <div class="glass-card" style="margin-bottom:1.5rem;">
                <div style="display:flex;justify-content:space-between;gap:1rem;align-items:center;flex-wrap:wrap;">
                    <div><h2>🌐 Domain Manager</h2><p style="color:var(--text-muted);">Disable a custom domain or place it in maintenance mode.</p></div>
                    <form method="POST" action="/admin/domains/check"><button class="btn btn-secondary">Run Health Check</button></form>
                </div>
                <div class="admin-table-wrap" style="margin-top:1rem;"><table class="admin-table"><thead><tr><th>Domain</th><th>Enabled</th><th>Maintenance</th><th>Health</th><th>Checked</th><th>Actions</th></tr></thead><tbody>
                <% (adminDomains||[]).forEach(function(d){ var domainState = d.maintenance ? 'maintenance' : (d.enabled ? 'active' : 'coming'); %>
                    <tr>
                        <td><strong class="admin-domain-name"><%= d.domain %></strong></td>
                        <td><span class="domain-state-pill <%= domainState %>"><%= d.enabled ? '✓ Enabled' : '○ Disabled' %></span></td>
                        <td>
                            <% if(d.maintenance){ %>
                                <span class="domain-state-pill maintenance">🛠 Maintenance • Coming Soon</span>
                            <% } else if(!d.enabled){ %>
                                <span class="domain-state-pill coming">⏳ Coming Soon</span>
                            <% } else { %>
                                <span class="domain-state-pill active">● Ready</span>
                            <% } %>
                        </td>
                        <td><span class="health-text"><%= d.last_health %></span></td>
                        <td><%= d.last_checked_at?new Date(d.last_checked_at).toLocaleString():'Never' %></td>
                        <td><div class="admin-actions">
                            <form method="POST" action="/admin/domains/<%= d.domain %>/toggle"><button class="btn btn-sm btn-secondary" <%= d.domain===baseDomain?'disabled':'' %>><%= d.enabled?'Disable':'Enable' %></button></form>
                            <form method="POST" action="/admin/domains/<%= d.domain %>/maintenance"><button class="btn btn-sm btn-warning"><%= d.maintenance?'End Maintenance':'Maintenance' %></button></form>
                        </div></td>
                    </tr><% }); %>
                </tbody></table></div>
            </div>

            <div class="glass-card" style="margin-bottom:1.5rem;">
                <div style="display:flex;justify-content:space-between;gap:1rem;align-items:center;flex-wrap:wrap;"><div><h2>💾 Database Snapshots</h2><p style="color:var(--text-muted);">App-level snapshots are kept in PostgreSQL. Also enable Railway backups for disaster recovery.</p></div><form method="POST" action="/admin/backup/create"><button class="btn btn-primary">Create Snapshot</button></form></div>
                <div class="admin-table-wrap" style="margin-top:1rem;"><table class="admin-table"><thead><tr><th>ID</th><th>Date</th><th>Created By</th><th>Download</th></tr></thead><tbody>
                <% (adminBackups||[]).forEach(function(b){ %><tr><td><%= b.id %></td><td><%= new Date(b.created_at).toLocaleString() %></td><td><%= b.created_by %></td><td><a class="btn btn-sm btn-secondary" href="/admin/backup/<%= b.id %>/download">JSON</a></td></tr><% }); %>
                <% if(!(adminBackups||[]).length){ %><tr><td colspan="4">No snapshots yet.</td></tr><% } %>
                </tbody></table></div>
            </div>

            <div class="glass-card" style="margin-bottom:1.5rem;">
                <h2 style="margin-bottom:1rem;">🧾 Admin Audit Log</h2>
                <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Date</th><th>Admin</th><th>Action</th><th>Target</th><th>Details</th><th>IP</th></tr></thead><tbody>
                <% (adminAudit||[]).forEach(function(a){ %><tr><td><%= new Date(a.created_at).toLocaleString() %></td><td><%= a.admin_email %></td><td><%= a.action %></td><td><%= a.target_type %> <%= a.target_id %></td><td><%= a.details %></td><td><%= a.ip_address %></td></tr><% }); %>
                </tbody></table></div>
            </div>

            <div class="glass-card">
                <h2 style="margin-bottom:1rem;">Recent Links</h2>
                <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th>User</th><th>Short URL</th><th>Destination</th><th>Clicks</th><th>Status</th><th>Actions</th></tr></thead><tbody>
                <% adminLinks.forEach(function(l){ var su='https://'+l.selected_domain+'/'+l.short_code; %><tr>
                    <td><%= l.id %></td>
                    <td><strong class="admin-user-cell"><%= l.display_name || l.username %></strong></td>
                    <td><a class="admin-short-url" href="<%= su %>" target="_blank" rel="noopener noreferrer"><i class="fas fa-link"></i> <span><%= su %></span></a></td>
                    <td><div class="admin-destination" title="<%= l.original_url %>"><%= l.original_url %></div></td>
                    <td><strong><%= l.clicks %></strong></td>
                    <td><span class="domain-state-pill <%= l.is_active?'active':'coming' %>"><%= l.is_active?'● Active':'○ Disabled' %></span></td>
                    <td><div class="admin-actions"><form action="/admin/links/<%= l.id %>/toggle" method="POST"><button class="btn btn-sm btn-secondary"><%= l.is_active?'Disable':'Enable' %></button></form><form action="/admin/links/<%= l.id %>/delete" method="POST" onsubmit="return confirm('Delete this link?')"><button class="btn btn-sm btn-danger">Delete</button></form></div></td>
                </tr><% }); %>
                </tbody></table></div>
            </div>
        <% } %>

        <!-- ===== 404 PAGE ===== -->
        <% if (page === '404') { %>
            <div class="glass-card error-page">
                <div class="error-code">404</div>
                <div class="error-title">Page Not Found</div>
                <div class="error-desc">The page you're looking for doesn't exist or has been moved.</div>
                <div style="margin-top: 2rem;">
                    <a href="/" class="btn btn-primary">🏠 Go Home</a>
                    <a href="/dashboard" class="btn btn-secondary">📊 Dashboard</a>
                </div>
            </div>
        <% } %>

        <% if (typeof user !== 'undefined' && user && page !== 'admin' && page !== 'admin-login' && page !== 'login') { %>
            </main>
        <% } %>
    </div>

    <% if (page !== 'admin' && page !== 'admin-login') { %>
<footer class="footer">
        <p>🔗 This Person Is brand Shortlink &bull; <span class="heart">❤️</span> &bull; Powered by <a href="https://t.me/thispersonisbrand537" target="_blank" rel="noopener noreferrer">@thispersonisbrand537</a></p>
        <p style="font-size: 0.75rem; margin-top: 0.5rem; opacity: 0.7;"><a href="/faq">FAQ</a> &bull; <a href="/privacy">Privacy</a> &bull; <a href="/terms">Terms</a></p>
        <p style="font-size: 0.75rem; margin-top: 0.5rem; opacity: 0.5;">© 2026 All rights reserved &bull; ♾️ Unlimited Short Links</p>
    </footer>
<% } else if (page === 'admin') { %>
    <footer class="admin-footer">
        <span><i class="fas fa-shield-halved"></i> THIS PERSON IS BRAND • Admin Control Center</span>
        <span>PostgreSQL Persistent Platform</span>
    </footer>
<% } %>

    <script>

        // ===== LOGIN MODAL =====
        function closeLoginModal() {
            var modal = document.getElementById('loginModal');
            if (modal) modal.classList.remove('active');
            window.location.href = '/';
        }

        // ===== DROPDOWN TOGGLE =====
        function toggleDropdown() {
            var menu = document.getElementById('dropdownMenu');
            var chevron = document.getElementById('dropdownChevron');
            if (menu) menu.classList.toggle('open');
            if (chevron) chevron.classList.toggle('open');
        }

        document.addEventListener('click', function(event) {
            var wrapper = document.querySelector('.user-menu-wrapper');
            if (wrapper && !wrapper.contains(event.target)) {
                var menu = document.getElementById('dropdownMenu');
                var chevron = document.getElementById('dropdownChevron');
                if (menu) menu.classList.remove('open');
                if (chevron) chevron.classList.remove('open');
            }
        });

        // ===== PROFILE MODAL =====
        function openProfileModal() {
            var modal = document.getElementById('profileModal');
            if (modal) {
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
                loadProfileData();
                var menu = document.getElementById('dropdownMenu');
                var chevron = document.getElementById('dropdownChevron');
                if (menu) menu.classList.remove('open');
                if (chevron) chevron.classList.remove('open');
            }
        }

        function closeProfileModal() {
            var modal = document.getElementById('profileModal');
            if (modal) {
                modal.classList.remove('active');
                document.body.style.overflow = 'auto';
            }
        }

        var profileModal = document.getElementById('profileModal');
        if (profileModal) {
            profileModal.addEventListener('click', function(e) {
                if (e.target === this) closeProfileModal();
            });
        }

        // ===== LOAD PROFILE DATA =====
        async function loadProfileData() {
            try {
                var response = await fetch('/api/user-data');
                var data = await response.json();
                if (data.error) {
                    showToast('Error loading profile: ' + data.error, 'error');
                    return;
                }
                renderProfile(data);
            } catch (error) {
                showToast('Error loading profile data', 'error');
            }
        }

        // ===== RENDER PROFILE =====
        function renderProfile(data) {
            var container = document.getElementById('profileContent');
            if (!container) return;
            
            var avatarLetter = (data.displayName || data.firstName || data.username || 'U').charAt(0).toUpperCase();
            var initials = (data.firstName ? data.firstName.charAt(0) : '') + (data.lastName ? data.lastName.charAt(0) : '');
            var completion = data.completion || 0;
            
            container.innerHTML = 
                '<div class="profile-avatar-section">' +
                    '<div class="profile-avatar">' +
                        (data.profilePhoto ? '<img src="' + data.profilePhoto + '" alt="Profile">' : (initials || avatarLetter)) +
                        '<div class="avatar-badge"><i class="fas fa-check"></i></div>' +
                    '</div>' +
                    '<div class="profile-display-name">' + (data.displayName || data.firstName || data.username || 'User') + '</div>' +
                    '<div class="profile-username">@' + (data.username || 'username') + '</div>' +
                '</div>' +
                '<div class="completion-section">' +
                    '<div class="completion-header"><span>Profile Completion</span><span>' + completion + '%</span></div>' +
                    '<div class="completion-bar"><div class="completion-fill" style="width: ' + completion + '%;"></div></div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-id-card"></i> Full Name</label>' +
                    '<div class="field-value editable" id="nameDisplay" onclick="editField(\'name\')">' + (data.firstName || '') + ' ' + (data.lastName || '') + '<span class="edit-icon"><i class="fas fa-pen"></i></span></div>' +
                    '<div class="field-value" id="nameEdit" style="display: none;">' +
                        '<input type="text" id="editFirstName" value="' + (data.firstName || '') + '" placeholder="First Name">' +
                        '<input type="text" id="editLastName" value="' + (data.lastName || '') + '" placeholder="Last Name" style="margin-top: 0.3rem;">' +
                        '<div style="display: flex; gap: 0.5rem; margin-top: 0.3rem;">' +
                            '<button class="btn btn-primary btn-sm" onclick="saveName()">Save</button>' +
                            '<button class="btn btn-secondary btn-sm" onclick="cancelEdit(\'name\')">Cancel</button>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-user"></i> Display Name</label>' +
                    '<div class="field-value editable" id="displayNameDisplay" onclick="editField(\'displayName\')">' + (data.displayName || data.firstName || data.username || 'User') + '<span class="edit-icon"><i class="fas fa-pen"></i></span></div>' +
                    '<div class="field-value" id="displayNameEdit" style="display: none;">' +
                        '<input type="text" id="editDisplayName" value="' + (data.displayName || '') + '" placeholder="Display Name">' +
                        '<div style="display: flex; gap: 0.5rem; margin-top: 0.3rem;">' +
                            '<button class="btn btn-primary btn-sm" onclick="saveDisplayName()">Save</button>' +
                            '<button class="btn btn-secondary btn-sm" onclick="cancelEdit(\'displayName\')">Cancel</button>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-at"></i> Email</label>' +
                    '<div class="field-value editable" id="emailDisplay" onclick="editField(\'email\')">' + (data.email || 'Not set') + '<span class="edit-icon"><i class="fas fa-pen"></i></span></div>' +
                    '<div class="field-value" id="emailEdit" style="display: none;">' +
                        '<input type="email" id="editEmail" value="' + (data.email || '') + '" placeholder="Enter your email">' +
                        '<div style="display: flex; gap: 0.5rem; margin-top: 0.3rem;">' +
                            '<button class="btn btn-primary btn-sm" onclick="saveEmail()">Save</button>' +
                            '<button class="btn btn-secondary btn-sm" onclick="cancelEdit(\'email\')">Cancel</button>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fab fa-telegram"></i> Telegram ID</label>' +
                    '<div class="field-value">' + (data.telegramId || 'N/A') + '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-calendar-plus"></i> Joined</label>' +
                    '<div class="field-value">' + (data.createdAt ? new Date(data.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A') + '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-clock"></i> Last Login</label>' +
                    '<div class="field-value">' + (data.lastLogin ? new Date(data.lastLogin).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'N/A') + '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-circle"></i> Account Status</label>' +
                    '<div class="field-value" style="text-transform: capitalize;">' + (data.accountStatus || 'active') + '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-link"></i> Total Links</label>' +
                    '<div class="field-value">' + (data.totalLinks || 0) + '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-mouse-pointer"></i> Total Clicks</label>' +
                    '<div class="field-value">' + (data.totalClicks || 0) + '</div>' +
                '</div>' +
                '<div class="profile-field">' +
                    '<label><i class="fas fa-globe"></i> Timezone</label>' +
                    '<div class="field-value">' + (data.timezone || 'Asia/Dhaka') + '</div>' +
                '</div>' +
                '<div class="modal-actions">' +
                    '<button class="btn btn-secondary" onclick="closeProfileModal()"><i class="fas fa-times"></i> Close</button>' +
                '</div>';
        }

        // ===== EDIT FUNCTIONS =====
        function editField(field) {
            if (field === 'name') {
                var nameDisplay = document.getElementById('nameDisplay');
