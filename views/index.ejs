                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        hover: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { labels: { color: '#DCE7FF', font: { family: 'Inter', size: 12 } } },
                            tooltip: {
                                enabled: true,
                                displayColors: false,
                                padding: 12,
                                cornerRadius: 10,
                                backgroundColor: 'rgba(10,16,36,0.97)',
                                titleColor: '#FFFFFF',
                                bodyColor: '#CFE8FF',
                                borderColor: 'rgba(124,92,255,0.48)',
                                borderWidth: 1,
                                callbacks: {
                                    title: function(items) {
