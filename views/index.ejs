        }

        .btn-secondary {
            color: #F3F7FF !important;
            background: rgba(255,255,255,.085) !important;
            border-color: rgba(255,255,255,.18) !important;
        }

        .btn-warning {
            color: #17120A !important;
            background: #FFCB5C !important;
        }

        .btn-danger {
            color: #FFFFFF !important;
        }

        .btn-telegram {
            color: #FFFFFF !important;
        }

