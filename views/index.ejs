        async function generateQRForDomain(shortCode, domain) {
            try {
                var response = await fetch('/qr/' + encodeURIComponent(shortCode) + '?domain=' + encodeURIComponent(domain));
                var data = await response.json();
                if (!data.qr) return showToast(data.error || 'QR generation failed', 'error');
                var win = window.open('', '_blank');
                if (!win) return showToast('Popup blocked. Allow popups to view QR.', 'error');
                win.document.write('<!doctype html><title>QR Code</title><body style="font-family:Arial;text-align:center;padding:30px;background:#111;color:white"><h2>QR Code</h2><img style="max-width:90vw;border-radius:16px" src="' + data.qr + '"><p style="word-break:break-all">' + data.url + '</p></body>');
                win.document.close();
            } catch (e) { showToast('QR generation failed', 'error'); }
        }


