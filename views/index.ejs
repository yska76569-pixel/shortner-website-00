                    <td><%= u.totalLinks %></td><td><%= u.realClicks || 0 %></td><td><%= u.botClicks || 0 %></td><td><%= u.uniqueVisitors || 0 %></td>
                    <td><div class="admin-actions">
                        <a class="btn btn-sm btn-primary" href="/admin/users/<%= u.id %>/stats"><i class="fas fa-chart-line"></i> Stats</a>
