                                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0.8rem; background: var(--glass); border-radius: 8px; border: 1px solid var(--glass-border);">
                                            <span class="device-tag">
                                                <%= device.device === 'Mobile' ? '📱' : device.device === 'Tablet' ? '📲' : '💻' %>
                                                <%= device.device || 'Unknown' %>
                                                <span style="color: var(--text-muted); font-size: 0.7rem;">(<%= device.browser || 'Unknown' %> / <%= device.os || 'Unknown' %>)</span>
                                            </span>
                                            <span style="color: var(--accent); font-weight: 600;"><%= device.count %></span>
                                        </div>
                                    <% }); %>
