                <form method="POST" action="/unlock/<%= link.id %>">
                    <input class="form-control" type="password" name="password" required autofocus placeholder="Link password">
                    <button class="btn btn-primary" style="width:100%;justify-content:center;margin-top:1rem;">Unlock & Continue</button>
                </form>
            </div>
        <% } %>

        <!-- ===== FAQ ===== -->
        <% if (page === 'faq') { %>
            <div class="brand-center"><h1 style="font-size:2.4rem;">FAQ</h1><p>Frequently asked questions about the shortener.</p></div>
            <div class="glass-card"><h3>How fast is redirect?</h3><p style="color:var(--text-muted);">Normal visitors use a direct HTTP 302 redirect after analytics and security checks.</p><hr style="border-color:var(--glass-border);margin:1rem 0;"><h3>Do custom domains work?</h3><p style="color:var(--text-muted);">Yes, when the domain is connected to Railway and enabled by the administrator.</p><hr style="border-color:var(--glass-border);margin:1rem 0;"><h3>Who can use the API?</h3><p style="color:var(--text-muted);">Premium users with an active API key.</p></div>
        <% } %>

        <% if (page === 'privacy') { %>
            <div class="brand-center"><h1 style="font-size:2.4rem;">Privacy Policy</h1></div>
            <div class="glass-card"><p style="color:var(--text-muted);line-height:1.8;">This service stores account details, short-link configuration, click analytics such as IP-derived country, device/browser information, payment records, and security logs to operate the service. Do not submit confidential information in URLs. Administrators should publish a final policy appropriate to their jurisdiction before public launch.</p></div>
        <% } %>

        <% if (page === 'terms') { %>
            <div class="brand-center"><h1 style="font-size:2.4rem;">Terms & Acceptable Use</h1></div>
            <div class="glass-card"><p style="color:var(--text-muted);line-height:1.8;">Users must not use the service for phishing, malware, fraud, illegal content, credential theft, abuse, or attempts to bypass platform/security restrictions. Links may be disabled and accounts may be blocked for abuse. Replace this starter text with legal terms reviewed for your business and jurisdiction before public launch.</p></div>
        <% } %>


        <!-- ===== PLANS PAGE ===== -->
        <% if (page === 'plans') { %>
            <div class="brand-center fade-in">
                <h1 style="font-size:2.4rem;">Plans & Premium</h1>
                <p>Free users can create up to <%= freeLinkLimit %> links. Premium users get unlimited links.</p>
                <div style="margin-top:.8rem;">
                    <span class="status-pill <%= user.isPremium ? 'ok' : 'warn' %>">
                        <%= user.isPremium ? ('PREMIUM until ' + new Date(user.premiumUntil).toLocaleDateString()) : 'FREE PLAN' %>
                    </span>
                </div>
            </div>

            <div class="plan-grid">
                <div class="plan-card">
                    <h3>Free</h3><div class="plan-price">৳0</div>
                    <p>Up to <%= freeLinkLimit %> short links</p><p>Core analytics</p><p>Custom domains when available</p>
                </div>
                <div class="plan-card featured">
                    <h3>Premium • 1 Month</h3><div class="plan-price">৳<%= plan1Price %> <span class="usd-price">≈ $<%= Number(plan1Usd).toFixed(2) %></span></div>
                    <p>Unlimited short links</p><p>Full analytics</p><p>No link-count limit</p>
                </div>
                <div class="plan-card featured">
                    <h3>Premium • 3 Months</h3><div class="plan-price">৳<%= plan3Price %> <span class="usd-price">≈ $<%= Number(plan3Usd).toFixed(2) %></span></div>
                    <p>Unlimited short links</p><p>Full analytics</p><p>Longer validity</p>
                </div>
            </div>

            <div class="glass-card payment-box interactive-payment-card">
                <div class="payment-heading">
                    <div><div class="payment-kicker">PREMIUM ACTIVATION</div><h2>Manual Payment</h2></div>
                    <span class="payment-secure"><i class="fas fa-shield-halved"></i> Admin Verified</span>
                </div>

                <div class="payment-method-cards">
                    <div class="payment-method-card bkash">
                        <div class="payment-method-title">bKash</div>
                        <div class="copy-payment-row"><strong id="bkashCopyValue"><%= bkashNumber %></strong><button type="button" class="copy-payment-btn" onclick="copyPaymentValue('bkashCopyValue','bKash number copied')"><i class="fas fa-copy"></i> Copy</button></div><span>⚠️ Send Money only</span>
                    </div>
                    <div class="payment-method-card nagad">
                        <div class="payment-method-title">Nagad</div>
                        <div class="copy-payment-row"><strong id="nagadCopyValue"><%= nagadNumber %></strong><button type="button" class="copy-payment-btn" onclick="copyPaymentValue('nagadCopyValue','Nagad number copied')"><i class="fas fa-copy"></i> Copy</button></div><span>⚠️ Send Money only</span>
                    </div>
                    <div class="payment-method-card binance">
                        <div class="payment-method-title">Binance</div>
                        <div class="copy-payment-row"><strong>Binance ID: <span id="binanceCopyValue"><%= typeof binanceId !== 'undefined' ? binanceId : 'Set in Railway Variables' %></span></strong><button type="button" class="copy-payment-btn" onclick="copyPaymentValue('binanceCopyValue','Binance ID copied')"><i class="fas fa-copy"></i> Copy</button></div>
                        <span>USD plan amount: 1 Month ≈ $<%= Number(plan1Usd).toFixed(2) %> • 3 Months ≈ $<%= Number(plan3Usd).toFixed(2) %><br>Submit Order ID + payment screenshot</span>
                    </div>
                </div>

                <div class="payment-warning">
                    <i class="fas fa-circle-exclamation"></i>
                    <div><strong>bKash / Nagad payment instruction</strong><span>এই নাম্বারে অবশ্যই <b>Send Money</b> করবেন। Cash Out / Payment অপশন ব্যবহার করবেন না। Send Money করার পরে Transaction ID এবং screenshot submit করুন।</span></div>
                </div>

                <form action="/payments" method="POST" enctype="multipart/form-data" id="premiumPaymentForm">
                    <div class="payment-form-grid">
                        <div class="form-group"><label>Plan</label><select class="form-control" name="planMonths" required><option value="1">1 Month — ৳<%= plan1Price %> / ≈ $<%= Number(plan1Usd).toFixed(2) %></option><option value="3">3 Months — ৳<%= plan3Price %> / ≈ $<%= Number(plan3Usd).toFixed(2) %></option></select></div>
                        <div class="form-group"><label>Payment Method</label><select class="form-control" name="method" id="paymentMethodSelect" required><option value="bkash">bKash — Send Money</option><option value="nagad">Nagad — Send Money</option><option value="binance">Binance</option></select></div>
                    </div>

                    <div id="localPaymentHelp" class="method-help active">
                        <i class="fas fa-mobile-screen-button"></i><span>Send Money করুন → Transaction ID কপি করুন → Screenshot নিন → নিচে submit করুন।</span>
                    </div>
                    <div id="binancePaymentHelp" class="method-help">
                        <i class="fab fa-bitcoin"></i><span>উপরের Binance ID-তে payment/transfer সম্পন্ন করে <b>Binance Order ID</b> এবং payment screenshot submit করুন।</span>
                    </div>

                    <div class="form-group">
                        <label id="paymentReferenceLabel">Transaction ID</label>
                        <input class="form-control" name="transactionId" id="paymentReferenceInput" required placeholder="Enter bKash/Nagad transaction ID">
                    </div>
                    <div class="form-group">
                        <label id="paymentScreenshotLabel">Payment Screenshot (PNG/JPG/WEBP, max 2MB)</label>
                        <input class="form-control" type="file" name="screenshot" accept="image/png,image/jpeg,image/webp" required>
