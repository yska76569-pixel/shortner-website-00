                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 0.5rem;">
                        <div>
                            <h4 style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.5rem;">🏳️ Top Countries</h4>
                            <div class="country-grid">
                                <% if (typeof countryStats !== 'undefined' && countryStats && countryStats.length > 0) { %>
                                    <% var maxCount = countryStats[0] ? countryStats[0].count : 1; %>
                                    <% countryStats.forEach(function(country) { 
                                        var percentage = Math.round((country.count / maxCount) * 100);
                                        var countryInfo = typeof countries !== 'undefined' && countries[country.countryCode] ? countries[country.countryCode] : null;
                                        var name = countryInfo ? countryInfo.name : (country.country || 'Unknown');
                                    %>
                                        <div class="country-item">
                                            <span class="country-name">
                                                <% if((country.countryCode||'XX') !== 'XX'){ %>
                                                  <img class="country-flag-img dashboard-country-flag" src="https://flagcdn.com/24x18/<%= String(country.countryCode).toLowerCase() %>.png" alt="<%= country.countryCode %> flag" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
                                                  <span class="country-code-fallback" style="display:none;"><%= country.countryCode %></span>
                                                <% } else { %>
                                                  <span class="country-code-fallback">🌐</span>
                                                <% } %>
                                                <%= name %>
                                            </span>
                                            <span style="display: flex; align-items: center; gap: 0.5rem;">
                                                <span class="country-clicks"><%= country.count %></span>
                                                <div style="width: 50px; height: 3px; background: var(--glass-border); border-radius: 4px; overflow: hidden;">
                                                    <div style="height: 100%; width: <%= percentage %>%; background: linear-gradient(90deg, var(--primary), var(--accent)); border-radius: 4px;"></div>
                                                </div>
                                            </span>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <p style="color: var(--text-muted); grid-column: 1 / -1; text-align: center; padding: 0.5rem;">No country data yet</p>
                                <% } %>
                            </div>
                        </div>
                        
