        /* Section reveal */
        .container > * {
            animation: pageFade .55s ease both;
        }
        @keyframes pageFade {
            from { opacity:0; transform:translateY(10px); }
            to { opacity:1; transform:translateY(0); }
        }

        /* soft floating dots */
        .ambient-dot {
            position:fixed;
            width:9px;height:9px;border-radius:50%;
            pointer-events:none;
            z-index:-1;
            background:rgba(126,247,199,.45);
            filter:blur(.2px);
            animation:dotFloat 9s ease-in-out infinite alternate;
        }
        .ambient-dot.dot-1{left:7%;top:20%}
        .ambient-dot.dot-2{right:9%;top:38%;animation-delay:2s;background:rgba(124,92,255,.45)}
        .ambient-dot.dot-3{left:18%;bottom:12%;animation-delay:4s;background:rgba(39,215,255,.40)}
        @keyframes dotFloat{from{transform:translateY(0) scale(1)}to{transform:translateY(-24px) scale(1.25)}}

        @media (max-width: 768px) {
            .navbar { width:calc(100% - 20px); margin-top:10px; border-radius:18px; }
