                <div class="stat-card"><div class="number"><%= adminStats.botClicks %></div><div class="label">Bot Clicks</div></div>
                <div class="stat-card"><div class="number"><%= adminStats.pendingPayments %></div><div class="label">Pending Payments</div></div>
