                    <p style="color:var(--text-muted);">Paste a URL, choose a domain, and get a fast branded short link.</p>
                </div>
                <div class="glass-card" style="margin-bottom:2rem;">
                    <form action="/shorten" method="POST" id="shortenForm">
                        <div class="form-group"><label>Destination URL</label><input type="url" class="form-control" name="originalUrl" placeholder="https://example.com/your-long-link" required></div>
                        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;">
                            <div class="form-group"><label>Short Domain</label><select class="form-control" name="domain" required>
                                <% if (typeof domainChoices !== 'undefined' && domainChoices && domainChoices.length) { %>
                                  <% domainChoices.forEach(function(d){ %>
                                    <option value="<%= d.domain %>" <%= d.selectable ? '' : 'disabled' %>><%= d.domain %><%= d.selectable ? '' : (d.maintenance ? ' — Maintenance • Coming Soon' : ' — Coming Soon') %></option>
                                  <% }); %>
                                <% } else { %>
                                  <% (availableDomains || []).forEach(function(domain){ %><option value="<%= domain %>"><%= domain %></option><% }); %>
                                <% } %>
                              </select></div>
                            <% if (typeof domainChoices !== 'undefined' && domainChoices && domainChoices.some(function(d){ return !d.selectable; })) { %>
                                <div class="domain-notice-panel">
                                    <div class="domain-notice-title"><i class="fas fa-circle-info"></i> Domain Status</div>
                                    <div class="domain-notice-list">
                                        <% domainChoices.filter(function(d){ return !d.selectable; }).forEach(function(d){ %>
                                            <div class="domain-notice-item">
                                                <span class="domain-notice-name"><%= d.domain %></span>
                                                <span class="domain-state-pill <%= d.maintenance?'maintenance':'coming' %>"><%= d.maintenance?'🛠 Maintenance • Coming Soon':'⏳ Coming Soon' %></span>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% } %>
                            <div class="form-group"><label>Custom Path (optional)</label><input type="text" class="form-control" name="customSlug" maxlength="48" pattern="[A-Za-z0-9_-]+" placeholder="my-link"></div>
                            <div class="form-group"><label>Expiry</label><select class="form-control" name="expiresIn"><option value="">Never</option><option value="1">1 Day</option><option value="7">7 Days</option><option value="30">30 Days</option><option value="90">90 Days</option></select></div>
                            <div class="form-group"><label>Password (Premium, optional)</label><input type="password" class="form-control" name="linkPassword" minlength="4" maxlength="100" placeholder="Protect this short link"></div>
                        </div>
                        <button type="submit" class="btn btn-primary" id="shortenBtn" style="width:100%;justify-content:center;padding:1rem;">🚀 Create Short Link</button>
                    </form>
                    <% if (typeof customDomains === 'undefined' || !customDomains || customDomains.length === 0) { %><div class="alert alert-info" style="margin-top:1rem;margin-bottom:0;">ℹ️ Only the base domain is active. Connected custom domains will appear here after you set DOMAIN_1, DOMAIN_2, etc. in Railway.</div><% } %>
                </div>
                <% if (typeof shortUrl !== 'undefined' && shortUrl) { %><div class="short-link-display" style="margin-bottom:2rem;"><div><div style="font-size:.8rem;color:var(--text-muted);margin-bottom:.3rem;">YOUR NEW SHORT LINK</div><span class="link"><%= shortUrl %></span></div><div style="display:flex;gap:.5rem;flex-wrap:wrap;"><button class="copy-btn" onclick="copyToClipboard('<%= shortUrl %>')">📋 Copy</button><a class="btn btn-secondary btn-sm" href="<%= shortUrl %>" target="_blank">↗ Test</a></div></div><% } %>
                <div class="glass-card" style="margin-bottom:2rem;"><h3 style="margin-bottom:.5rem;">👁️ Social Preview</h3><p style="color:var(--text-muted);font-size:.9rem;">Supported social crawlers see your short-domain title and a light description; normal visitors still redirect immediately.</p><div style="margin-top:1rem;background:#fff;color:#222;border-radius:14px;overflow:hidden;max-width:560px;box-shadow:var(--shadow);"><div style="height:130px;background:linear-gradient(135deg,#111827,#312e81);display:flex;align-items:center;justify-content:center;color:#fff;font-size:2.3rem;">🔗</div><div style="padding:1rem;"><div style="font-size:.75rem;text-transform:uppercase;color:#777;"><%= typeof baseDomain !== 'undefined' ? baseDomain : 'thispersonisbrandshortner.com' %></div><strong style="display:block;margin:.25rem 0;"><%= typeof baseDomain !== 'undefined' ? baseDomain : 'thispersonisbrandshortner.com' %></strong><span style="font-size:.85rem;color:#666;">Fast, clean and secure short links powered by THIS PERSON IS BRAND.</span></div></div></div>
                <h2 style="margin-bottom:1rem;">Recent Short Links</h2>
                <% if (typeof links !== 'undefined' && links && links.length) { %><% links.forEach(function(link) { %><div class="link-card"><div class="link-top"><div><a class="link-url" href="<%= link.shortUrl %>" target="_blank">🔗 <%= link.shortUrl %></a><div class="link-original">→ <%= link.originalUrl %></div></div><div style="display:flex;gap:.4rem;flex-wrap:wrap;"><button class="btn btn-secondary btn-sm copy-link-btn" data-url="<%= link.shortUrl %>">📋 Copy</button><button class="btn btn-secondary btn-sm" onclick="generateQRForDomain('<%= link.shortCode %>','<%= link.selectedDomain %>')">📱 QR</button></div></div><div class="link-meta"><span>👁️ <%= link.clicks || 0 %> clicks</span><span>🌐 <%= link.selectedDomain || (typeof baseDomain !== 'undefined' ? baseDomain : '') %></span><% if(link.passwordEnabled){ %><span>🔒 Password</span><% } %></div></div><% }); %><% } else { %><div class="glass-card" style="text-align:center;color:var(--text-muted);">No links yet. Create your first one above.</div><% } %>
            </div>
        <% } %>


        <!-- ===== PREMIUM API PAGE ===== -->
        <% if (page === 'api-access') { %>
            <div class="brand-center fade-in">
