                                        <span style="color: var(--success); font-weight: 600;"><%= typeof realClicks !== 'undefined' ? realClicks : 0 %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <h2 style="margin-bottom: 1.5rem; font-weight: 700;">My Short Links</h2>

                <% if (typeof links !== 'undefined' && links && links.length > 0) { %>
                    <% links.forEach(function(link) { 
                        var linkUrl = link.shortUrl || '';
                        var linkId = link.id || link._id || '';
                        var linkCode = link.shortCode || '';
                        var linkOriginal = link.originalUrl || '';
                        var linkClicks = link.clicks || 0;
                        var linkCreated = link.createdAt || '';
                        var linkTitle = link.title || '';
                        var isExpired = link.isExpired || false;
                        var isActive = link.isActive !== undefined ? link.isActive : true;
                    %>
                        <div class="link-card">
                            <div class="link-top">
                                <div>
                                    <a href="<%= linkUrl %>" target="_blank" rel="noopener noreferrer" class="link-url">🔗 <%= linkUrl %></a>
                                    <% if (linkTitle) { %><div class="link-title"><%= linkTitle %></div><% } %>
                                    <div class="link-original">→ <%= linkOriginal %></div>
                                </div>
                                <div style="display: flex; gap: 0.3rem; flex-wrap: wrap;">
                                    <button class="btn btn-secondary btn-sm copy-link-btn" data-url="<%= linkUrl %>" style="flex-shrink: 0; cursor: pointer;">📋 Copy</button>
                                    <button class="btn btn-secondary btn-sm" onclick="generateQRForDomain('<%= linkCode %>','<%= link.selectedDomain || (typeof baseDomain !== 'undefined' ? baseDomain : '') %>')" style="flex-shrink: 0; cursor: pointer;">📱 QR</button>
                                    <a class="btn btn-primary btn-sm" href="/links/<%= linkId %>/stats" style="flex-shrink:0;"><i class="fas fa-chart-line"></i> Statistics</a>
                                </div>
                            </div>
                            <div class="link-meta">
                                <span>👁️ <%= linkClicks %> clicks</span>
                                <span>📅 <span class="link-date" data-date="<%= linkCreated %>"><%= linkCreated %></span></span>
                                <span>🆔 <%= linkCode %></span>
                                <% if (isExpired) { %>
                                    <span class="badge badge-expired">⏰ Expired</span>
                                <% } else if (!isActive) { %>
                                    <span class="badge badge-inactive">⛔ Inactive</span>
                                <% } else { %>
                                    <span class="badge badge-active">✅ Active</span>
                                <% } %>
                            </div>
                            <div class="link-actions">
                                <form action="/update-link/<%= linkId %>" method="POST" class="edit-form">
                                    <input type="url" name="newUrl" placeholder="Enter new URL" required>
                                    <div class="edit-actions">
                                        <button type="submit" class="btn btn-warning btn-sm">✏️ Update</button>
                                    </div>
                                </form>
                                <details class="auto-update-box" <%= link.autoUpdateEnabled ? 'open' : '' %>>
                                  <summary>⚡ Automatic Link Update <%= link.autoUpdateEnabled ? '• ON' : '' %></summary>
                                  <form action="/links/<%= linkId %>/auto-update" method="POST" class="auto-update-form">
                                    <input type="hidden" name="returnTo" value="/dashboard">
                                    <input type="url" name="autoUpdateUrl" value="<%= link.autoUpdateUrl || '' %>" placeholder="Next destination URL" required>
                                    <input type="number" name="autoUpdateThreshold" min="1" max="1000000" value="<%= link.autoUpdateThreshold || 20 %>" placeholder="Clicks" required>
                                    <button class="btn btn-primary btn-sm" type="submit">⚡ Save Auto Update</button>
                                  </form>
                                  <% if(link.autoUpdateEnabled){ %><div class="auto-update-status">Will switch after <strong><%= link.autoUpdateThreshold %></strong> new real clicks. Progress: <strong><%= Math.max(0,Number(link.clicks||0)-Number(link.autoUpdateStartClicks||0)) %>/<%= link.autoUpdateThreshold %></strong></div><form action="/links/<%= linkId %>/auto-update/disable" method="POST"><input type="hidden" name="returnTo" value="/dashboard"><button class="btn btn-danger btn-sm" type="submit">Disable Auto Update</button></form><% } %>
                                </details>
                                <div class="btn-group">
                                    <form action="/toggle-link/<%= linkId %>" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-secondary btn-sm" onclick="return confirm('Toggle this link?')"><%= isActive ? '⏸️' : '▶️' %></button>
                                    </form>
                                    <form action="/delete-link/<%= linkId %>" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this link?')">🗑️ Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="glass-card" style="text-align: center; padding: 3.5rem;">
                        <p style="color: var(--text-muted); font-size: 1.2rem;">You haven't created any links yet</p>
                        <p style="color: var(--text-muted); margin-top: 0.5rem;">Open Short Link from the top menu to create your first short link!</p>
                    </div>
                <% } %>
            </div>

                </main>

                <!-- Premium Create Short Link Popup -->
                <div id="createLinkModal" class="modal-overlay premium-create-modal" aria-hidden="true">
                    <div class="modal-content create-link-modal-card">
                        <div class="create-modal-glow"></div>
                        <div class="modal-header create-modal-header">
                            <div>
                                <div class="create-modal-badge"><i class="fas fa-wand-magic-sparkles"></i> SMART SHORTENER</div>
                                <h2>Create a Short Link</h2>
                                <p>Paste your long URL, pick a branded domain and publish instantly.</p>
                            </div>
                            <button class="modal-close" type="button" onclick="closeCreateLinkModal()" aria-label="Close">×</button>
                        </div>

                        <form action="/shorten" method="POST" id="dashboardShortenForm">
                            <div class="create-url-box">
                                <div class="create-url-icon"><i class="fas fa-link"></i></div>
                                <input type="url" name="originalUrl" placeholder="https://example.com/your-long-link" required>
                            </div>

                            <div class="create-modal-grid">
                                <div class="form-group">
                                    <label><i class="fas fa-globe"></i> Short Domain</label>
                                    <select class="form-control" name="domain" required>
                                        <% if(typeof domainChoices!=='undefined' && domainChoices && domainChoices.length){ %>
                                            <% domainChoices.forEach(function(d){ %>
                                                <option value="<%= d.domain %>" <%= d.selectable?'':'disabled' %>><%= d.domain %><%= d.selectable?'':(d.planRestricted?' — Premium Only':(d.maintenance?' — Maintenance • Coming Soon':' — Coming Soon')) %></option>
                                            <% }); %>
                                        <% } else { %>
                                            <% (availableDomains||[]).forEach(function(domain){ %><option value="<%= domain %>"><%= domain %></option><% }); %>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label><i class="fas fa-pen"></i> Custom Path</label>
                                    <input class="form-control" type="text" name="customSlug" maxlength="48" pattern="[A-Za-z0-9_-]+" placeholder="my-brand-link">
