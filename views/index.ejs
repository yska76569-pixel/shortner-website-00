        /* ===== V7.2 ICON / TEXT / BUTTON VISIBILITY FIX ===== */

        /* Global readable text */
        body, .container, .navbar, .glass-card, .link-card, .stat-card,
        .feature-card, .modal-content, .dropdown-menu, .admin-table,
        .admin-table th, .admin-table td {
            color: var(--text) !important;
        }

        p, label, small, .label, .tiny-note, .link-original,
        .profile-item-label, .plan-usage-sub, .plan-usage-expiry {
            opacity: 1 !important;
        }

        /* Navigation text and icons */
        .navbar a,
        .navbar button,
        .nav-links a,
        .user-profile-btn,
        .dropdown-item {
            color: #F7FAFF !important;
            opacity: 1 !important;
        }

        .nav-links a {
            font-weight: 700 !important;
        }

        .dropdown-item {
            display: flex !important;
            align-items: center !important;
            gap: .75rem !important;
            min-height: 42px !important;
        }

        /* Font Awesome icons everywhere */
        i,
        .fa,
        .fas,
        .far,
        .fab,
        [class^="fa-"],
        [class*=" fa-"] {
            color: currentColor !important;
            opacity: 1 !important;
            visibility: visible !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            min-width: 1.1em !important;
            line-height: 1 !important;
        }

        /* Inline SVG icons everywhere */
        svg,
        .telegram-inline-icon,
        .facebook-inline-icon,
        .whatsapp-inline-icon {
            display: inline-block !important;
            width: 1.15em !important;
            height: 1.15em !important;
            min-width: 1.15em !important;
            flex: 0 0 auto !important;
            color: currentColor !important;
            fill: currentColor !important;
            opacity: 1 !important;
            visibility: visible !important;
            vertical-align: -0.15em !important;
        }

        svg path {
            fill: currentColor;
        }

        /* Dashboard / navigation icon emphasis */
        .nav-links a[href="/dashboard"],
        .nav-links a[href="/shorten-page"],
        .nav-links a[href="/api-access"],
        .nav-links a[href="/notifications"],
        .nav-links a[href="/plans"],
        .nav-links a[href="/admin"] {
            position: relative;
            z-index: 2;
        }

        /* Buttons: never let shine overlay hide text/icon */
        .btn,
        button,
        .copy-btn {
            color: #FFFFFF !important;
            opacity: 1 !important;
            visibility: visible !important;
            isolation: isolate;
        }

        .btn > *,
        button > *,
        .copy-btn > * {
            position: relative;
            z-index: 2;
            color: inherit !important;
            opacity: 1 !important;
        }

