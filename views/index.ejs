                    <td><span class="status-pill <%= p.status==='approved'?'ok':(p.status==='rejected'?'bad':'warn') %>"><%= p.status %></span></td>
                    <td><div class="admin-actions"><form action="/admin/payments/<%= p.id %>/approve" method="POST"><button class="btn btn-sm btn-primary" <%= p.status==='approved'?'disabled':'' %>>Approve</button></form><form action="/admin/payments/<%= p.id %>/reject" method="POST"><button class="btn btn-sm btn-danger">Reject</button></form></div></td>
                </tr><% }); %>
                <% if(!adminPayments.length){ %><tr><td colspan="9">No payments yet.</td></tr><% } %>
                </tbody></table></div>
            </div>




            
<div class="glass-card tool-maintenance-card" style="margin-bottom:1.5rem;">
