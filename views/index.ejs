                <div class="admin-country-list">
                  <% if(targetTopCountries.length){ targetTopCountries.forEach(function(c,i){ var ci=countries[c.country_code||'XX'] || countries['XX']; %>
                    <div class="admin-user-country-row">
                      <span class="admin-rank">#<%= i+1 %></span>
                      <span class="country-name">
                        <% if((c.country_code||'XX')!=='XX'){ %><img class="country-flag-img" src="https://flagcdn.com/24x18/<%= String(c.country_code).toLowerCase() %>.png" alt="<%= c.country_code %> flag" loading="lazy"><% } else { %><span class="country-code-fallback">🌐</span><% } %>
                        <strong><%= ci.name %></strong>
                      </span>
                      <strong class="admin-country-value"><%= Number(c.count||0).toLocaleString() %></strong>
                    </div>
                  <% }); } else { %><div class="google-saved-empty">No country data yet.</div><% } %>
                </div>
              </div>

              <div class="glass-card admin-country-panel">
                <div class="admin-analytics-head"><div><h2>🔗 Top 10 Links</h2><p>Best-performing links for this user.</p></div></div>
                <div class="admin-top-link-list">
                  <% if(targetTopLinks.length){ targetTopLinks.forEach(function(l,i){ %>
                    <div class="admin-top-link-row">
                      <span class="admin-rank">#<%= i+1 %></span>
                      <div><a href="<%= l.shortUrl %>" target="_blank" rel="noopener"><%= l.shortUrl %></a><small><%= l.originalUrl %></small></div>
                      <span><strong><%= l.realClicks %></strong> real<br><small><%= l.botClicks %> bot</small></span>
                    </div>
                  <% }); } else { %><div class="google-saved-empty">No links yet.</div><% } %>
                </div>
              </div>
            </div>

            <div class="glass-card per-link-recent">
