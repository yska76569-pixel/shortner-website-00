                    <% } else if (user.apiEnabled) { %>
                        <div class="alert alert-info">Active key: <strong><%= user.apiKeyPrefix %>••••••••</strong></div>
                    <% } else { %><div class="alert alert-info">No active API key.</div><% } %>
                    <div style="display:flex;gap:.6rem;flex-wrap:wrap;">
                        <form method="POST" action="/api-access/generate"><button class="btn btn-primary">Generate / Rotate Key</button></form>
                        <% if(user.apiEnabled){ %><form method="POST" action="/api-access/revoke"><button class="btn btn-danger">Revoke Key</button></form><% } %>
                    </div>
                </div>
                <div class="glass-card">
                    <h2>API Usage</h2>
                    <p style="color:var(--text-muted);margin:.7rem 0;">Header: <code>X-API-Key: YOUR_KEY</code></p>
                    <h3 style="margin-top:1rem;">POST /api/v1/shorten</h3>
                    <pre style="white-space:pre-wrap;background:#080812;padding:1rem;border-radius:12px;overflow:auto;">{
  "url": "https://example.com/long-url",
  "domain": "<%= baseDomain %>",
  "customSlug": "optional-name",
  "expiresIn": 30,
  "password": "optional-premium-password"
}</pre>
                    <h3 style="margin-top:1rem;">GET /api/v1/links</h3>
                    <h3 style="margin-top:.6rem;">GET /api/v1/stats</h3>
                </div>
            <% } %>
        <% } %>

        <!-- ===== NOTIFICATIONS PAGE ===== -->
        <% if (page === 'notifications') { %>
            <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem;">
                <div><h1>🔔 Notifications</h1><p style="color:var(--text-muted);">Payments, plans, account and link updates.</p></div>
