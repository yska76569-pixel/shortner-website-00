                var chartLabels = chartDays.length
                    ? chartDays.map(function(d){ return d.day.slice(0,3) + ' • ' + d.date.replace(/ \d{4}$/,''); })
                    : ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
                var chartValues = chartDays.length
                    ? chartDays.map(function(d){ return d.clicks; })
