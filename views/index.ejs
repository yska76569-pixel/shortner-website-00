                <div class="dashboard-kicker">ADMIN USER ANALYTICS</div>
                <h1><i class="fas fa-user-chart"></i> <%= targetUser.displayName || targetUser.username %> — Statistics</h1>
                <p>@<%= targetUser.username %> · <%= targetUser.isPremium?'Premium':'Free' %> · User ID <%= targetUser.id %></p>
              </div>
              <a href="/admin" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Admin Panel</a>
            </div>

            <div class="admin-user-stat-grid">
              <div class="mini-summary-card"><span>Total Links</span><strong><%= targetLinks.length %></strong></div>
              <div class="mini-summary-card"><span>Real Clicks</span><strong><%= targetRealClicks %></strong></div>
              <div class="mini-summary-card"><span>Unique Visitors</span><strong><%= targetUniqueVisitors %></strong></div>
              <div class="mini-summary-card"><span>Bot / Preview</span><strong><%= targetBotClicks %></strong></div>
            </div>

            <div class="glass-card per-link-chart-card">
