              <% if(targetRecentClicks.length){ %>
                <div class="per-link-click-table">
                  <div class="per-click-head"><span>Country</span><span>Device / Browser</span><span>Location</span><span>Date & Time</span></div>
                  <% targetRecentClicks.forEach(function(c){ var ci=countries[c.countryCode||'XX'] || countries['XX']; %>
                    <div class="per-click-row">
                      <div class="click-cell click-country" data-label="Country">
                        <span class="country-flag-wrap">
                          <% if((c.countryCode||'XX')!=='XX'){ %><img class="country-flag-img recent-flag" src="https://flagcdn.com/24x18/<%= String(c.countryCode).toLowerCase() %>.png" alt="<%= c.countryCode %> flag" loading="lazy"><% } else { %><span class="country-code-fallback">🌐</span><% } %>
                        </span>
                        <div><strong><%= ci.name %></strong><small><%= c.countryCode||'XX' %></small></div>
                      </div>
                      <div class="click-cell" data-label="Device / Browser"><strong><%= c.device||'Unknown' %></strong><small><%= c.browser||'Unknown' %> • <%= c.os||'Unknown' %></small></div>
                      <div class="click-cell" data-label="Location"><strong><%= c.city||'Unknown city' %></strong><small><%= c.region||'Unknown region' %></small></div>
                      <div class="click-cell" data-label="Date & Time"><strong class="link-date" data-date="<%= c.createdAt %>"><%= c.createdAt %></strong><small>Real click</small></div>
                    </div>
                  <% }); %>
                </div>
              <% } else { %><div class="google-saved-empty">No real clicks yet.</div><% } %>
            </div>
          </div>
        <% } %>

<% if (page === 'admin') { %>
            <div class="admin-page-heading">
