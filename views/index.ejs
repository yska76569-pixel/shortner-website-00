                    <button class="btn btn-primary payment-submit-btn" type="submit"><i class="fas fa-paper-plane"></i> Submit for Admin Verification</button>
                </form>
            </div>

            <div class="glass-card">
                <h2 style="margin-bottom:1rem;">Payment History</h2>
                <div class="admin-table-wrap"><table class="admin-table" style="min-width:700px;"><thead><tr><th>Date</th><th>Plan</th><th>Method</th><th>Reference / Order ID</th><th>Status</th><th>Note</th></tr></thead><tbody>
                <% (paymentHistory || []).forEach(function(p){ %>
                    <tr><td><%= new Date(p.created_at).toLocaleString() %></td><td><%= p.plan_months %> month</td><td><%= p.method %></td><td><%= p.transaction_id %></td>
                    <td><span class="status-pill <%= p.status==='approved'?'ok':(p.status==='rejected'?'bad':'warn') %>"><%= p.status %></span></td><td><%= p.admin_note || '-' %></td></tr>
                <% }); %>
                <% if (!(paymentHistory||[]).length) { %><tr><td colspan="6">No payment requests yet.</td></tr><% } %>
                </tbody></table></div>
            </div>
        <% } %>

        <!-- ===== ADMIN LOGIN ===== -->
        <% if (page === 'admin-login') { %>
            <div class="glass-card" style="max-width:500px;margin:3rem auto;">
                <h2 style="text-align:center;margin-bottom:1rem;">🛡️ Admin Login</h2>
                <form action="/admin/login" method="POST">
                    <div class="form-group"><label>Admin Email</label><input class="form-control" type="email" name="email" required></div>
                    <div class="form-group"><label>Admin Password</label><input class="form-control" type="password" name="password" required></div>
                    <button class="btn btn-primary" style="width:100%;justify-content:center;" type="submit">Open Admin Control Center</button>
                </form>
            </div>
        <% } %>

        <!-- ===== ADMIN PANEL ===== -->
