                      <span class="admin-country-value"><%= Number(c.count||0).toLocaleString() %></span>
                      <span class="admin-country-bar"><span style="width:<%= pct %>%"></span></span>
                    </div>
                  <% }); } else { %><div class="google-saved-empty">No real country traffic yet.</div><% } %>
                </div>
              </div>

              <div class="glass-card admin-country-panel">
