                            <option value="Europe/Vienna">🇦🇹 Austria (Europe/Vienna)</option>
                            <option value="Europe/Budapest">🇭🇺 Hungary (Europe/Budapest)</option>
                            <option value="Europe/Prague">🇨🇿 Czech Republic (Europe/Prague)</option>
                            <option value="Europe/Dublin">🇮🇪 Ireland (Europe/Dublin)</option>
                            <option value="Pacific/Auckland">🇳🇿 New Zealand (Pacific/Auckland)</option>
                            <option value="America/Santiago">🇨🇱 Chile (America/Santiago)</option>
                            <option value="America/Bogota">🇨🇴 Colombia (America/Bogota)</option>
                            <option value="America/Lima">🇵🇪 Peru (America/Lima)</option>
                            <option value="America/Caracas">🇻🇪 Venezuela (America/Caracas)</option>
                        </select>
                        <span class="timezone-display" id="currentTimeDisplay">Loading time...</span>
                    </div>
                </div>

                <div class="glass-card" style="margin-bottom: 2rem;">
                    <h3 style="margin-bottom: 0.5rem; font-weight: 700;">🌍 Visitor Analytics</h3>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem;">See where your visitors are coming from and what devices they use</p>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 0.5rem;">
                        <div>
                            <h4 style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.5rem;">🏳️ Top Countries</h4>
                            <div class="country-grid">
                                <% if (typeof countryStats !== 'undefined' && countryStats && countryStats.length > 0) { %>
                                    <% var maxCount = countryStats[0] ? countryStats[0].count : 1; %>
                                    <% countryStats.forEach(function(country) { 
                                        var percentage = Math.round((country.count / maxCount) * 100);
                                        var countryInfo = typeof countries !== 'undefined' && countries[country.countryCode] ? countries[country.countryCode] : null;
                                        var flag = countryInfo ? countryInfo.flag : '🌍';
                                        var name = countryInfo ? countryInfo.name : (country.country || 'Unknown');
                                    %>
                                        <div class="country-item">
                                            <span class="country-name"><span class="country-flag"><%= flag %></span> <%= name %></span>
                                            <span style="display: flex; align-items: center; gap: 0.5rem;">
                                                <span class="country-clicks"><%= country.count %></span>
                                                <div style="width: 50px; height: 3px; background: var(--glass-border); border-radius: 4px; overflow: hidden;">
                                                    <div style="height: 100%; width: <%= percentage %>%; background: linear-gradient(90deg, var(--primary), var(--accent)); border-radius: 4px;"></div>
                                                </div>
                                            </span>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <p style="color: var(--text-muted); grid-column: 1 / -1; text-align: center; padding: 0.5rem;">No country data yet</p>
                                <% } %>
                            </div>
                        </div>
                        
                        <div>
                            <h4 style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.5rem;">📱 Devices & Browsers</h4>
                            <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                                <% if (typeof deviceStats !== 'undefined' && deviceStats && deviceStats.length > 0) { %>
                                    <% deviceStats.forEach(function(device) { %>
                                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0.8rem; background: var(--glass); border-radius: 8px; border: 1px solid var(--glass-border);">
                                            <span class="device-tag">
                                                <%= device.device === 'Mobile' ? '📱' : device.device === 'Tablet' ? '📲' : '💻' %>
                                                <%= device.device || 'Unknown' %>
                                                <span style="color: var(--text-muted); font-size: 0.7rem;">(<%= device.browser || 'Unknown' %> / <%= device.os || 'Unknown' %>)</span>
                                            </span>
                                            <span style="color: var(--accent); font-weight: 600;"><%= device.count %></span>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <p style="color: var(--text-muted); text-align: center; padding: 0.5rem;">No device data yet</p>
                                <% } %>
                                
                                <div style="margin-top: 0.5rem; padding: 0.5rem 0.8rem; background: var(--glass); border-radius: 8px; border: 1px solid var(--glass-border);">
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <span style="color: var(--text-muted);">🤖 Bot Protection</span>
                                        <span style="color: var(--success); font-weight: 600;">✅ Active</span>
                                    </div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.2rem;">
                                        <span style="color: var(--text-muted); font-size: 0.8rem;">Bot Clicks Blocked</span>
                                        <span style="color: var(--danger); font-weight: 600;"><%= typeof botClicks !== 'undefined' ? botClicks : 0 %></span>
                                    </div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.2rem;">
                                        <span style="color: var(--text-muted); font-size: 0.8rem;">Real Clicks</span>
                                        <span style="color: var(--success); font-weight: 600;"><%= typeof realClicks !== 'undefined' ? realClicks : 0 %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <h2 style="margin-bottom: 1.5rem; font-weight: 700;">My Short Links</h2>

                <% if (typeof links !== 'undefined' && links && links.length > 0) { %>
                    <% links.forEach(function(link) { 
                        var linkUrl = link.shortUrl || '';
                        var linkId = link.id || link._id || '';
                        var linkCode = link.shortCode || '';
                        var linkOriginal = link.originalUrl || '';
                        var linkClicks = link.clicks || 0;
                        var linkCreated = link.createdAt || '';
                        var linkTitle = link.title || '';
                        var isExpired = link.isExpired || false;
                        var isActive = link.isActive !== undefined ? link.isActive : true;
                    %>
                        <div class="link-card">
                            <div class="link-top">
                                <div>
                                    <a href="<%= linkUrl %>" target="_blank" rel="noopener noreferrer" class="link-url">🔗 <%= linkUrl %></a>
                                    <% if (linkTitle) { %><div class="link-title"><%= linkTitle %></div><% } %>
                                    <div class="link-original">→ <%= linkOriginal %></div>
                                </div>
                                <div style="display: flex; gap: 0.3rem; flex-wrap: wrap;">
                                    <button class="btn btn-secondary btn-sm copy-link-btn" data-url="<%= linkUrl %>" style="flex-shrink: 0; cursor: pointer;">📋 Copy</button>
                                    <button class="btn btn-secondary btn-sm" onclick="generateQR('<%= linkCode %>')" style="flex-shrink: 0; cursor: pointer;">📱 QR</button>
                                </div>
                            </div>
                            <div class="link-meta">
                                <span>👁️ <%= linkClicks %> clicks</span>
                                <span>📅 <span class="link-date" data-date="<%= linkCreated %>"><%= linkCreated %></span></span>
                                <span>🆔 <%= linkCode %></span>
                                <% if (isExpired) { %>
                                    <span class="badge badge-expired">⏰ Expired</span>
                                <% } else if (!isActive) { %>
                                    <span class="badge badge-inactive">⛔ Inactive</span>
                                <% } else { %>
                                    <span class="badge badge-active">✅ Active</span>
                                <% } %>
                            </div>
                            <div class="link-actions">
                                <form action="/update-link/<%= linkId %>" method="POST" class="edit-form">
                                    <input type="url" name="newUrl" placeholder="Enter new URL" required>
                                    <div class="edit-actions">
                                        <button type="submit" class="btn btn-warning btn-sm">✏️ Update</button>
                                    </div>
                                </form>
                                <div class="btn-group">
                                    <form action="/toggle-link/<%= linkId %>" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-secondary btn-sm" onclick="return confirm('Toggle this link?')"><%= isActive ? '⏸️' : '▶️' %></button>
                                    </form>
                                    <form action="/delete-link/<%= linkId %>" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this link?')">🗑️ Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="glass-card" style="text-align: center; padding: 3.5rem;">
                        <p style="color: var(--text-muted); font-size: 1.2rem;">You haven't created any links yet</p>
                        <p style="color: var(--text-muted); margin-top: 0.5rem;">Open Short Link from the top menu to create your first short link!</p>
                    </div>
                <% } %>
            </div>

                </main>

                <!-- Premium Create Short Link Popup -->
                <div id="createLinkModal" class="modal-overlay premium-create-modal" aria-hidden="true">
                    <div class="modal-content create-link-modal-card">
                        <div class="create-modal-glow"></div>
                        <div class="modal-header create-modal-header">
                            <div>
                                <div class="create-modal-badge"><i class="fas fa-wand-magic-sparkles"></i> SMART SHORTENER</div>
                                <h2>Create a Short Link</h2>
                                <p>Paste your long URL, pick a branded domain and publish instantly.</p>
                            </div>
                            <button class="modal-close" type="button" onclick="closeCreateLinkModal()" aria-label="Close">×</button>
                        </div>

                        <form action="/shorten" method="POST" id="dashboardShortenForm">
                            <div class="create-url-box">
                                <div class="create-url-icon"><i class="fas fa-link"></i></div>
                                <input type="url" name="originalUrl" placeholder="https://example.com/your-long-link" required>
                            </div>

                            <div class="create-modal-grid">
                                <div class="form-group">
                                    <label><i class="fas fa-globe"></i> Short Domain</label>
                                    <select class="form-control" name="domain" required>
                                        <% if(typeof domainChoices!=='undefined' && domainChoices && domainChoices.length){ %>
                                            <% domainChoices.forEach(function(d){ %>
                                                <option value="<%= d.domain %>" <%= d.selectable?'':'disabled' %>><%= d.domain %><%= d.selectable?'':(d.maintenance?' — Maintenance • Coming Soon':' — Coming Soon') %></option>
                                            <% }); %>
                                        <% } else { %>
                                            <% (availableDomains||[]).forEach(function(domain){ %><option value="<%= domain %>"><%= domain %></option><% }); %>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label><i class="fas fa-pen"></i> Custom Path</label>
                                    <input class="form-control" type="text" name="customSlug" maxlength="48" pattern="[A-Za-z0-9_-]+" placeholder="my-brand-link">
                                </div>
                                <div class="form-group">
                                    <label><i class="fas fa-hourglass-half"></i> Expiry</label>
                                    <select class="form-control" name="expiresIn">
                                        <option value="">Never</option><option value="1">1 Day</option><option value="7">7 Days</option><option value="30">30 Days</option><option value="90">90 Days</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label><i class="fas fa-lock"></i> Password <span>Premium</span></label>
                                    <input class="form-control" type="password" name="linkPassword" minlength="4" maxlength="100" placeholder="Optional password">
                                </div>
                            </div>

                            <% if(typeof domainChoices!=='undefined' && domainChoices && domainChoices.some(function(d){return !d.selectable;})){ %>
                                <div class="create-domain-status">
                                    <i class="fas fa-circle-info"></i>
                                    <div><strong>Domain notice</strong><span>Maintenance/Coming Soon domains are visible but cannot be selected yet.</span></div>
                                </div>
                            <% } %>

                            <div class="create-modal-bottom">
                                <div class="create-speed-note"><i class="fas fa-bolt"></i><span><strong>Fast 302 Redirect</strong><small>Analytics + bot detection included</small></span></div>
                                <button type="submit" class="btn btn-primary create-modal-submit"><i class="fas fa-rocket"></i> Shorten Now</button>
                            </div>
                        </form>
                    </div>
                </div>

        <% } %>


        <!-- ===== MY SHORT LINKS PAGE ===== -->
        <% if (page === 'my-links') { %>
            <div class="my-links-header">
                <div><div class="dashboard-kicker">YOUR LIBRARY</div><h1><i class="fas fa-link"></i> My Short Links</h1><p>Only links created by your account are shown here.</p></div>
                <a href="/shorten-page" class="btn btn-primary"><i class="fas fa-plus"></i> Create New Link</a>
            </div>
            <div class="my-links-summary">
                <div class="mini-summary-card"><span>Total Links</span><strong><%= (links||[]).length %></strong></div>
                <div class="mini-summary-card"><span>Total Clicks</span><strong><%= (links||[]).reduce(function(sum,l){return sum+Number(l.clicks||0)},0) %></strong></div>
                <div class="mini-summary-card"><span>Active</span><strong><%= (links||[]).filter(function(l){return l.isActive && !l.isExpired}).length %></strong></div>
            </div>
            <div class="glass-card my-links-panel">
                <div class="my-links-panel-title"><h2>Your Links</h2><span><%= (links||[]).length %> saved</span></div>
                <% if (links && links.length) { %>
                    <% links.forEach(function(link){ %>
                        <div class="link-card my-link-owned-card">
                            <div class="link-top">
                                <div style="min-width:0;flex:1;"><a class="link-url" href="<%= link.shortUrl %>" target="_blank" rel="noopener noreferrer"><%= link.shortUrl %></a><div class="link-original"><%= link.originalUrl %></div></div>
                                <div class="my-link-quick-actions"><button class="btn btn-secondary btn-sm copy-link-btn" data-url="<%= link.shortUrl %>"><i class="fas fa-copy"></i> Copy</button><button class="btn btn-secondary btn-sm" onclick="generateQRForDomain('<%= link.shortCode %>','<%= link.selectedDomain %>')"><i class="fas fa-qrcode"></i> QR</button></div>
                            </div>
                            <div class="link-meta"><span><i class="fas fa-arrow-pointer"></i> <%= link.clicks || 0 %> clicks</span><span><i class="fas fa-globe"></i> <%= link.selectedDomain %></span><% if(link.passwordEnabled){ %><span><i class="fas fa-lock"></i> Password</span><% } %><span class="badge <%= link.isActive ? 'badge-active' : 'badge-inactive' %>"><%= link.isActive ? 'Active' : 'Disabled' %></span></div>
                            <div class="link-actions">
                                <form action="/links/<%= link.id %>/update" method="POST" class="edit-form"><input type="url" name="originalUrl" value="<%= link.originalUrl %>" required><button class="btn btn-sm btn-secondary" type="submit"><i class="fas fa-pen"></i> Update</button></form>
                                <div class="btn-group"><form action="/links/<%= link.id %>/toggle" method="POST"><button class="btn btn-sm btn-secondary" type="submit"><%= link.isActive ? 'Disable' : 'Enable' %></button></form><form action="/links/<%= link.id %>/delete" method="POST" onsubmit="return confirm('Delete this short link?')"><button class="btn btn-sm btn-danger" type="submit"><i class="fas fa-trash"></i> Delete</button></form></div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="empty-links-state"><i class="fas fa-link"></i><h3>No short links yet</h3><p>Create your first link and it will appear here.</p><a href="/shorten-page" class="btn btn-primary">Create First Link</a></div>
                <% } %>
            </div>
        <% } %>

        <!-- ===== SHORT LINK PAGE ===== -->
        <% if (page === 'shorten') { %>
            <div class="fade-in">
                <div style="text-align:center;margin-bottom:2rem;">
                    <div style="font-size:3rem;">⚡</div>
