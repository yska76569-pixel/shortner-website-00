        async function generateQRForDomain(shortCode, domain) {
            try {
                var cleanDomain = String(domain || '').trim()
                    .replace(/^https?:\/\//i, '')
                    .replace(/\/$/, '');
                var qrPath = '/qr/' + encodeURIComponent(shortCode);
                if (cleanDomain) qrPath += '?domain=' + encodeURIComponent(cleanDomain);

                var response = await fetch(qrPath, { cache: 'no-store' });
                var data = await response.json();

                if (!response.ok || !data.qr) {
                    return showToast(data.error || 'QR generation failed', 'error');
                }

                var win = window.open('', '_blank');
                if (!win) return showToast('Popup blocked. Allow popups to view QR.', 'error');

                var safeUrl = String(data.url || '');
                var safeUrlHtml = safeUrl
                    .replace(/&/g,'&amp;')
                    .replace(/</g,'&lt;')
                    .replace(/>/g,'&gt;')
                    .replace(/"/g,'&quot;')
                    .replace(/'/g,'&#039;');
                win.document.write(
                    '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">' +
                    '<title>QR Code</title></head>' +
                    '<body style="font-family:Inter,Arial,sans-serif;text-align:center;padding:30px;background:#0b1020;color:white;margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;">' +
                    '<div style="max-width:420px;width:100%;background:#151d38;border:1px solid #2b3c68;padding:24px;border-radius:22px;">' +
                    '<h2 style="margin-top:0">QR Code</h2>' +
                    '<div style="background:white;padding:16px;border-radius:16px;display:inline-block"><img alt="QR Code" style="display:block;max-width:280px;width:75vw;height:auto" src="' + data.qr + '"></div>' +
                    '<p style="word-break:break-all;color:#9eeaff;font-size:14px;line-height:1.5">' + safeUrlHtml + '</p>' +
                    '<p style="color:#9eacc8;font-size:12px">This QR opens the exact selected short-link domain.</p>' +
                    '<button onclick="window.close()" style="margin-top:8px;padding:10px 18px;background:#6c63ff;border:0;border-radius:10px;color:white;cursor:pointer">Close</button>' +
                    '</div></body></html>'
                );
                win.document.close();
            } catch (e) {
                console.error('QR generation failed:', e);
                showToast('QR generation failed', 'error');
            }
        }


