        function copyPaymentValue(elementId, successMessage) {
            var el=document.getElementById(elementId); if(!el)return;
            var value=(el.textContent||'').trim(); if(!value || value==='Not configured'){ if(typeof showToast==='function') showToast('Payment info is not configured','error'); return; }
            function done(){ if(typeof showToast==='function') showToast(successMessage||'Copied','success'); }
            if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(value).then(done).catch(function(){fallbackCopy(value,done);});}
            else fallbackCopy(value,done);
        }
        function fallbackCopy(value,done){var ta=document.createElement('textarea');ta.value=value;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();try{document.execCommand('copy');done();}catch(e){}document.body.removeChild(ta);}


        // ===== V7.16 PREMIUM DOMAIN DROPDOWN BODY PORTAL =====
        (function(){
            var nativeSelect=document.getElementById('shortDomainSelect');
            var wrapper=document.getElementById('premiumDomainSelect');
            var trigger=document.getElementById('premiumDomainTrigger');
            var current=document.getElementById('premiumDomainCurrent');
            var menu=document.getElementById('premiumDomainMenu');
            var optionsHolder=document.getElementById('premiumDomainOptions');
            var count=document.getElementById('premiumDomainCount');

            if(!nativeSelect||!wrapper||!trigger||!menu||!optionsHolder)return;

            var originalParent = menu.parentNode;
            var originalNextSibling = menu.nextSibling;

            function cleanLabel(text){
                return String(text||'').replace(/\s+/g,' ').trim();
            }

            function domainFromOption(option){
                return cleanLabel(option.value||option.textContent);
            }

            function stateFromOption(option){
                var text=cleanLabel(option.textContent).toLowerCase();
                var disabled=!!option.disabled;
                var premiumOnly=text.indexOf('premium only')!==-1;
                var waiting=disabled||premiumOnly||text.indexOf('maintenance')!==-1||text.indexOf('coming soon')!==-1;
                return {
                    disabled:disabled,
                    waiting:waiting,
                    statusText:waiting?(text.indexOf('maintenance')!==-1?'Maintenance':'Coming Soon'):'Ready'
                };
            }

            function renderOptions(){
                optionsHolder.innerHTML='';
                var selectableCount=0;

                Array.from(nativeSelect.options).forEach(function(option){
                    var domain=domainFromOption(option);
                    if(!domain)return;

                    var state=stateFromOption(option);
                    if(!state.disabled)selectableCount++;

                    var btn=document.createElement('button');
                    btn.type='button';
                    btn.className='premium-domain-option'+(option.selected?' selected':'')+(state.disabled?' disabled':'');
                    btn.setAttribute('role','option');
                    btn.setAttribute('aria-selected',option.selected?'true':'false');

                    var left=document.createElement('div');
                    left.className='premium-domain-option-left';

                    var icon=document.createElement('div');
                    icon.className='premium-domain-option-icon';
                    icon.innerHTML=state.waiting
                        ? '<i class="fas fa-hourglass-half"></i>'
                        : '<i class="fas fa-globe"></i>';

                    var copy=document.createElement('div');
                    copy.className='premium-domain-option-copy';

                    var strong=document.createElement('strong');
                    strong.textContent=domain;

                    var sub=document.createElement('span');
                    sub.textContent=state.waiting
                        ? 'Temporarily unavailable'
                        : 'Active branded short domain';

                    copy.appendChild(strong);
                    copy.appendChild(sub);
                    left.appendChild(icon);
                    left.appendChild(copy);

                    var status=document.createElement('span');
                    status.className='premium-domain-status '+(state.waiting?'waiting':'ready');
                    status.innerHTML=state.waiting
                        ? '<i class="fas fa-clock"></i> '+state.statusText
                        : '<i class="fas fa-circle-check"></i> Ready';

                    btn.appendChild(left);
                    btn.appendChild(status);

                    if(!state.disabled){
                        btn.addEventListener('click',function(){
                            nativeSelect.value=option.value;
                            nativeSelect.dispatchEvent(new Event('change',{bubbles:true}));
                            current.textContent=domain;
                            closeMenu();
                            renderOptions();
                        });
                    }

                    optionsHolder.appendChild(btn);
                });

                if(count)count.textContent=selectableCount;
                var selected=nativeSelect.options[nativeSelect.selectedIndex];
                if(selected&&current)current.textContent=domainFromOption(selected);
            }

            function positionMenu(){
                var r=trigger.getBoundingClientRect();
                var vw=Math.max(document.documentElement.clientWidth||0,window.innerWidth||0);
                var vh=Math.max(document.documentElement.clientHeight||0,window.innerHeight||0);

                var menuWidth=Math.min(560, vw-24);
                var left=Math.max(12, Math.min(r.left, vw-menuWidth-12));

                menu.style.width=menuWidth+'px';
                menu.style.left=left+'px';

                // Default below trigger. If too little room, open upward.
                var desiredHeight=Math.min(440, menu.scrollHeight||440);
                var roomBelow=vh-r.bottom-12;
                var roomAbove=r.top-12;

                if(roomBelow>=Math.min(desiredHeight,260) || roomBelow>=roomAbove){
                    menu.style.top=(r.bottom+10)+'px';
                    menu.style.bottom='auto';
                    menu.style.maxHeight=Math.max(220,Math.min(440,roomBelow))+'px';
                    menu.style.transformOrigin='top left';
                }else{
                    menu.style.top='auto';
                    menu.style.bottom=(vh-r.top+10)+'px';
                    menu.style.maxHeight=Math.max(220,Math.min(440,roomAbove))+'px';
                    menu.style.transformOrigin='bottom left';
                }
            }

            function openMenu(){
                if(!document.body.contains(menu) || menu.parentNode!==document.body){
                    document.body.appendChild(menu);
                }
                menu.classList.add('portal-mode');
                menu.classList.remove('portal-hidden');
                wrapper.classList.add('open');
                trigger.setAttribute('aria-expanded','true');
                document.body.classList.add('domain-dropdown-open');
                positionMenu();
            }

            function closeMenu(){
                wrapper.classList.remove('open');
                trigger.setAttribute('aria-expanded','false');
                document.body.classList.remove('domain-dropdown-open');
                menu.classList.remove('portal-mode');
                menu.classList.add('portal-hidden');

                // Restore menu into original DOM location to keep markup stable.
                if(originalParent){
                    if(originalNextSibling && originalNextSibling.parentNode===originalParent){
                        originalParent.insertBefore(menu,originalNextSibling);
                    }else{
                        originalParent.appendChild(menu);
                    }
                }
                menu.classList.remove('portal-hidden');
                menu.removeAttribute('style');
            }

            trigger.addEventListener('click',function(e){
                e.preventDefault();
                e.stopPropagation();
                wrapper.classList.contains('open') ? closeMenu() : openMenu();
            });

            document.addEventListener('click',function(e){
                if(wrapper.classList.contains('open') && !menu.contains(e.target) && !trigger.contains(e.target)){
                    closeMenu();
                }
            });

            document.addEventListener('keydown',function(e){
                if(e.key==='Escape')closeMenu();
            });

            window.addEventListener('resize',function(){
                if(wrapper.classList.contains('open'))positionMenu();
            });

            window.addEventListener('scroll',function(){
                if(wrapper.classList.contains('open'))positionMenu();
            },true);

            nativeSelect.addEventListener('change',renderOptions);
            renderOptions();
        })();

        // ===== TOAST =====
        function showToast(message, type, duration) {
            type = type || 'info';
            duration = duration || 3000;
            var container = document.getElementById('toastContainer');
            if (!container) return;
            
            var icons = { success: 'fas fa-check-circle', error: 'fas fa-exclamation-circle', info: 'fas fa-info-circle' };

            var toast = document.createElement('div');
            toast.className = 'toast ' + type;
            toast.innerHTML = 
                '<span class="toast-icon"><i class="' + (icons[type] || icons.info) + '"></i></span>' +
                '<span class="toast-message">' + message + '</span>' +
                '<button class="toast-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>';

            container.appendChild(toast);

            setTimeout(function() {
                toast.style.animation = 'slideOutRight 0.4s ease forwards';
                setTimeout(function() {
                    if (toast.parentElement) toast.remove();
                }, 400);
            }, duration);
        }

        // ===== COPY =====
        function copyToClipboard(text) {
            var cleanText = String(text).trim();
            if (!cleanText || cleanText === '') {
                showToast('❌ Error: Nothing to copy', 'error');
                return;
            }
            
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(cleanText).then(function() {
                    showToast('✅ Link copied to clipboard!', 'success');
                }).catch(function() {
                    fallbackCopy(cleanText);
                });
            } else {
                fallbackCopy(cleanText);
            }
        }

        function fallbackCopy(text) {
            try {
                var textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                textarea.style.width = '1px';
                textarea.style.height = '1px';
                document.body.appendChild(textarea);
                textarea.select();
                var success = document.execCommand('copy');
                document.body.removeChild(textarea);
                if (success) {
                    showToast('✅ Link copied to clipboard!', 'success');
                } else {
                    showToast('❌ Failed to copy. Please copy manually.', 'error');
                }
            } catch (err) {
                showToast('❌ Failed to copy. Please copy manually.', 'error');
            }
        }

        // ===== QR CODE =====
        async function generateQR(shortCode, domain) {
            try {
                var qrPath = '/qr/' + encodeURIComponent(shortCode);
                if (domain) qrPath += '?domain=' + encodeURIComponent(domain);
                var response = await fetch(qrPath);
                var data = await response.json();
                if (data.qr) {
                    var win = window.open('', '_blank');
                    if (win) {
                        win.document.write(
                            '<html><head><title>QR Code</title></head>' +
                            '<body style="background:#0D0D1A;display:flex;justify-content:center;align-items:center;height:100vh;margin:0;font-family:Inter,sans-serif;flex-direction:column;">' +
                            '<div style="background:white;padding:20px;border-radius:12px;">' +
                            '<img src="' + data.qr + '" style="max-width:300px;width:100%;">' +
                            '</div>' +
                            '<p style="color:#B0B0C8;margin-top:20px;font-size:14px;">Scan to visit: ' + data.url + '</p>' +
                            '<button onclick="window.close()" style="margin-top:10px;padding:8px 20px;background:#6C63FF;border:none;border-radius:8px;color:white;cursor:pointer;">Close</button>' +
                            '</body></html>'
                        );
                    }
                }
            } catch (error) {
                showToast('❌ Failed to generate QR code', 'error');
            }
        }

        // ===== LIVE USER COUNT =====
        setInterval(async function() {
            try {
                var response = await fetch('/api/online-users');
                var data = await response.json();
                var countEl = document.getElementById('liveUserCount');
                if (countEl) countEl.textContent = (data.count || 0) + ' Online';
                var listEl = document.getElementById('userList');
                if (listEl && data.users) {
                    if (data.users.length > 0) {
                        var html = '';
                        for (var i = 0; i < data.users.length; i++) {
                            html += '<span class="user-badge"><span class="online-dot"></span> ' + data.users[i].name + '</span>';
                        }
                        listEl.innerHTML = html;
                    } else {
                        listEl.innerHTML = '<span style="color: var(--text-muted);">No users online</span>';
                    }
                }
            } catch (e) {}
        }, 10000);

        // ===== KEYBOARD SHORTCUTS =====
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeProfileModal();
            }
            if (e.ctrlKey && e.key === 'k') {
                e.preventDefault();
                window.location.href = '/dashboard';
            }
            if (e.ctrlKey && e.shiftKey && e.key === 'L') {
                e.preventDefault();
                var logoutForm = document.querySelector('form[action="/logout"]');
                if (logoutForm) logoutForm.submit();
            }
        });
    </script>


    <script>
    document.addEventListener('DOMContentLoaded',function(){
      var panel=document.getElementById('publicLiveStats');
      if(!panel)return;

      async function refreshPublicLiveStats(){
        try{
          var r=await fetch('/api/live-stats',{cache:'no-store'});
          if(!r.ok)return;
          var d=await r.json();

          ['users','links','realClicks','websiteVisitors','liveVisitors','pageViews'].forEach(function(k){
            var el=panel.querySelector('[data-live="'+k+'"]');
            if(el && d[k]!==undefined){
              el.textContent=Number(d[k]||0).toLocaleString();
            }
          });
        }catch(_){}
      }

      refreshPublicLiveStats();
      setInterval(refreshPublicLiveStats,10000);
    });
    </script>


<script>
(function(){
  function fitOneLiveNumber(el){
    if(!el || !el.parentElement) return;

    // Important: the stylesheet uses !important for font-size,
    // so JS must also set the inline value with !important.
    var card = el.parentElement;
    var available = Math.max(40, card.clientWidth - 18);
    var maxSize = window.innerWidth <= 760 ? 34 : 42;
    var minSize = 11;

    el.style.setProperty('font-size', maxSize + 'px', 'important');
    el.style.setProperty('letter-spacing', '-0.035em', 'important');
    el.style.setProperty('white-space', 'nowrap', 'important');
    el.style.setProperty('max-width', '100%', 'important');

    var size = maxSize;
    var guard = 0;

    // Shrink until the complete formatted number fits in the card.
    while(el.scrollWidth > available && size > minSize && guard < 80){
      size -= 1;
      el.style.setProperty('font-size', size + 'px', 'important');
      guard++;
    }

    // Very large future values: tighten spacing slightly before allowing overflow.
    if(el.scrollWidth > available){
      el.style.setProperty('letter-spacing', '-0.075em', 'important');
      guard = 0;
      while(el.scrollWidth > available && size > 9 && guard < 30){
        size -= 0.5;
        el.style.setProperty('font-size', size + 'px', 'important');
        guard++;
      }
    }
  }

  function fitLiveStatNumbers(){
    document.querySelectorAll('#publicLiveStats .stat-card .number').forEach(fitOneLiveNumber);
  }

  function scheduleFit(){
    window.requestAnimationFrame(function(){
      fitLiveStatNumbers();
      setTimeout(fitLiveStatNumbers, 60);
    });
  }

  document.addEventListener('DOMContentLoaded',function(){
    scheduleFit();
    window.addEventListener('resize',scheduleFit);

    var target=document.getElementById('publicLiveStats');
    if(target && 'MutationObserver' in window){
      new MutationObserver(scheduleFit).observe(target,{
        subtree:true,
        childList:true,
        characterData:true
      });
    }

    if(target && 'ResizeObserver' in window){
      new ResizeObserver(scheduleFit).observe(target);
    }
  });
})();
</script>


<script id="maintenanceTimerAdminHelper">
(function(){
  function pad2(n){return String(n).padStart(2,'0');}

  function toLocalInputValue(d){
    return d.getFullYear()+'-'+pad2(d.getMonth()+1)+'-'+pad2(d.getDate())+
      'T'+pad2(d.getHours())+':'+pad2(d.getMinutes());
  }

  function updateResumeFields(){
    var mode=document.getElementById('maintenanceResumeMode');
    var duration=document.getElementById('maintenanceDurationGroup');
    var exact=document.getElementById('maintenanceExactGroup');
    if(!mode)return;

    if(duration) duration.style.display=mode.value==='duration'?'block':'none';
    if(exact) exact.style.display=mode.value==='exact'?'block':'none';
  }

  function updateCustomMinutes(){
    var preset=document.getElementById('maintenanceResumePreset');
    var custom=document.getElementById('maintenanceCustomMinutes');
    if(!preset || !custom)return;
    custom.style.display=preset.value==='custom'?'block':'none';
    if(preset.value!=='custom') custom.value='';
  }

  function formatLeft(ms){
    if(ms<=0)return '00:00:00';
    var total=Math.floor(ms/1000);
    var days=Math.floor(total/86400);
    var hours=Math.floor((total%86400)/3600);
    var mins=Math.floor((total%3600)/60);
    var secs=total%60;
    return (days>0?days+'d ':'')+pad2(hours)+':'+pad2(mins)+':'+pad2(secs);
  }

  document.addEventListener('DOMContentLoaded',function(){
    var offset=document.getElementById('maintenanceTimezoneOffset');
    if(offset) offset.value=String(new Date().getTimezoneOffset());

    var mode=document.getElementById('maintenanceResumeMode');
    var preset=document.getElementById('maintenanceResumePreset');
    if(mode) mode.addEventListener('change',updateResumeFields);
    if(preset) preset.addEventListener('change',updateCustomMinutes);

    updateResumeFields();
    updateCustomMinutes();

    var current=document.getElementById('maintenanceCurrentAuto');
    var left=document.getElementById('maintenanceCurrentLeft');
    var exactInput=document.getElementById('maintenanceUntilInput');

    if(current && current.dataset.utc){
      var d=new Date(current.dataset.utc);

      if(!isNaN(d.getTime())){
        current.textContent=d.toLocaleString();
        if(exactInput) exactInput.value=toLocalInputValue(d);

        function tick(){
          if(left) left.textContent='Time left: '+formatLeft(d.getTime()-Date.now());
        }

        tick();
        setInterval(tick,1000);
      }
    }
  });
})();
</script>

