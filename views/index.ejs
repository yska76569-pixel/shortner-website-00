                        <div style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;"><strong><%= n.title %></strong><small style="color:var(--text-muted);"><%= new Date(n.created_at).toLocaleString() %></small></div>
                        <p style="color:var(--text-muted);margin-top:.4rem;"><%= n.message %></p>
                    </div>
                <% }); %>
            <% } else { %><div class="glass-card">No notifications yet.</div><% } %>
        <% } %>

        <!-- ===== PASSWORD PAGE ===== -->
        <% if (page === 'link-password') { %>
            <div class="glass-card" style="max-width:520px;margin:3rem auto;text-align:center;">
                <div style="font-size:3rem;">🔒</div><h2>Password Protected Link</h2>
