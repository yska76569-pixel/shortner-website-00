        .toast {
            padding: 1rem 1.2rem; border-radius: 14px;
            background: rgba(13,13,26,0.95); backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border); box-shadow: var(--shadow);
            display: flex; align-items: center; gap: 0.8rem;
